import { Button, ComboBox, ListView, ScrollView, TabWidget, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SourcePage, SourceTab, SourceBreakpoint } from "pages/source.slint";
import { InstallToolsPage, SelectToolsPage, ToolRow } from "pages/tools.slint";
import { VariablesPage, WatchRow } from "pages/variables.slint";
import { WaveformsPage, WaveformRow } from "pages/waveforms.slint";
import { FirmwarePage, FirmwareTreeRow } from "pages/firmware.slint";
import { DebugPage, FrameRow, BreakpointRow } from "pages/debug.slint";
import { DebugSettings } from "pages/debug-settings.slint";
import { TargetRow, PackRow } from "pages/target-selector.slint";
export { SourceTab, SourceBreakpoint, FirmwareTreeRow, WatchRow, ToolRow, FrameRow, BreakpointRow, TargetRow, PackRow, WaveformRow }

component PanelDivider inherits Rectangle {
    callback drag-start();
    callback drag(length);
    width: 10px;
    background: transparent;
    Rectangle {
        width: 2px;
        height: 40px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 1px;
        background: handle.has-hover || handle.pressed ? Theme.accent : Theme.border;
    }
    handle := TouchArea {
        property <length> start-x;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.start-x = self.absolute-position.x + self.mouse-x;
                root.drag-start();
            }
        }
        moved => {
            if self.pressed {
                root.drag(self.absolute-position.x + self.mouse-x - self.start-x);
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "NyaScraping · Embedded Debug Studio";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1480px;
    preferred-height: 900px;
    min-width: 1180px;
    min-height: 720px;
    background: Theme.background;
    default-font-size: 14px;

    in-out property <bool> busy: false;
    in-out property <bool> file-dialog-open: false;
    in-out property <bool> project-dialog-open: true;
    in-out property <[string]> project-history;
    in-out property <string> project-path;
    callback new-project();
    callback open-project(string);
    callback browse-project();
    callback save-project();
    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab: 0;
    in-out property <string> settings-message;
    in-out property <int> refresh-rate-index: 0;
    callback refresh-rate-changed();
    private property <bool> interaction-busy: root.busy || root.file-dialog-open || root.project-dialog-open || root.settings-open;
    private property <length> left-panel-width: 300px;
    private property <length> right-panel-width: 360px;
    private property <length> drag-panel-width;
    changed width => {
        root.left-panel-width = min(root.left-panel-width, max(260px, root.width - 40px - 360px - 330px));
        root.right-panel-width = min(root.right-panel-width, max(330px, root.width - 40px - 360px - root.left-panel-width));
    }
    in-out property <bool> debug-connected: false;
    in-out property <bool> debug-halted: false;
    in-out property <bool> debug-running: false;
    in-out property <string> debug-state: "未连接";
    in-out property <string> gdb-path: "arm-none-eabi-gdb";
    in-out property <string> debug-target;
    in-out property <int> backend-kind: -1;
    in-out property <[TargetRow]> targets;
    in-out property <[PackRow]> packs;
    in-out property <string> target-message: "请先选择调试后端";
    in-out property <string> target-search;
    callback refresh-targets();
    callback search-targets(string);
    callback add-pack();
    callback remove-pack(string);
    callback install-pack(string);
    in-out property <string> debug-interface;
    in-out property <[TargetRow]> probes;
    in-out property <string> probe-message;
    in-out property <string> probe-search;
    callback search-probes(string);
    callback browse-probe();
    in-out property <string> debug-port: "3333";
    in-out property <bool> external-server: false;
    in-out property <[FrameRow]> stack-frames;
    in-out property <[BreakpointRow]> breakpoints;
    in-out property <string> debug-log;
    in-out property <string> execution-location;
    callback debug-action(int);
    callback add-breakpoint(string);
    callback remove-breakpoint(string);
    callback toggle-source-breakpoint(int);
    callback show-breakpoints();
    callback select-frame(int);
    in-out property <int> current-tab: 0;
    in-out property <string> status: "就绪";
    in-out property <[ToolRow]> tools;
    in-out property <string> backend-summary: "尚未选择调试后端";
    in-out property <string> tool-message: "扫描 PATH 工具与已安装版本。";
    in-out property <[SourceTab]> source-tabs;
    in-out property <int> source-selected-tab: -1;
    callback select-source-tab(int);
    callback close-source-tab(int);
    callback open-tree-source(string);
    in-out property <string> source-path;
    in-out property <string> source-title: "尚未打开文件";
    in-out property <string> source-meta: "";
    in-out property <string> source-text: "打开一个源码文件以开始浏览。";
    in-out property <int> source-line-count;
    in-out property <[SourceBreakpoint]> source-breakpoints;
    in-out property <[bool]> source-executable-lines;
    in-out property <string> source-line-hint;
    in-out property <string> firmware-path;
    in-out property <string> firmware-title: "尚未打开编译产物";
    in-out property <string> firmware-meta;
    in-out property <string> firmware-report: "解析编译产物后，在这里查看段、节与符号表。";
    in-out property <[FirmwareTreeRow]> firmware-tree;
    in-out property <int> firmware-tree-label-width;
    in-out property <int> firmware-tree-content-width;
    in-out property <int> firmware-selected-node: -1;
    in-out property <string> firmware-details: "选择文件树中的函数或变量，查看类型、声明位置及存储位置。";
    in-out property <bool> functions-visible: false;
    in-out property <[WatchRow]> watches;
    in-out property <[WaveformRow]> waveform-channels;
    in-out property <[string]> waveform-charts: ["图表 1"];
    in-out property <int> waveform-selected-chart: 0;
    in-out property <image> waveform-plot;
    in-out property <[string]> waveform-axis-channels;
    in-out property <int> waveform-axis-index;
    in-out property <[string]> waveform-y-ticks: ["—", "—", "—", "—", "—"];
    in-out property <[string]> waveform-time-ticks: ["-5 s", "-3.75 s", "-2.5 s", "-1.25 s", "0 s"];
    in-out property <string> waveform-zoom-label;
    callback zoom-waveform(bool, bool, bool);
    callback select-waveform-axis(int);
    in-out property <bool> waveform-detached: false;
    callback toggle-waveform-window(bool);
    callback add-waveform-chart();
    callback select-waveform-chart(int);
    callback move-waveform-channel(int, int, int);
    callback export-waveform-csv();
    callback clear-waveform-history();
    in-out property <bool> acquisition-active: false;
    in-out property <string> acquisition-status: "采集未启动";
    in-out property <string> acquisition-statistics: "每通道最多保留 32768 个样本；尚无采集数据";
    in-out property <string> acquisition-endpoint: "127.0.0.1:6666";
    out property <bool> acquisition-uses-session: root.backend-kind == 1 || root.backend-kind == 2;
    out property <string> acquisition-source-label: root.backend-kind == 1 ? "pyOCD · 调试会话" : root.backend-kind == 2 ? "probe-rs · 调试会话" : "OpenOCD Tcl";
    callback refresh-tools();
    callback install-tool(int, string);
    callback select-tool(int, string);
    callback uninstall-tool(int, string);
    callback add-local-tool(int, string, string);
    callback remove-local-tool(int, string);
    callback browse-local-tool();
    in-out property <string> local-tool-directory;
    callback open-source();
    callback open-firmware();
    callback browse-source();
    callback browse-firmware();
    callback select-firmware-node(int);
    callback select-firmware-file(int);
    callback add-firmware-variable(int);
    callback add-expression(string);
    callback remove-watch(int);
    callback plot-variable(int);
    callback toggle-waveform(int, int);
    callback start-acquisition();
    callback stop-acquisition();
    callback toggle-watch(int, int);
    callback show-functions(bool);
    in-out property <string> firmware-search;
    callback search-firmware(string);
    in-out property <bool> live-enabled: false;
    in-out property <int> live-interval-index: 5;
    in-out property <string> live-custom-hz: "10";
    in-out property <string> live-frequency-error;
    in-out property <string> watch-sample-status: "实时刷新已关闭";
    callback live-refresh();
    in-out property <int> watch-revision;
    callback write-watch(int, int, string);

    MenuBar {
        Menu {
            title: "文件";
            MenuItem { title: "打开项目…"; enabled: !root.interaction-busy && !root.debug-connected; activated => { root.browse-project(); } }
            MenuItem { title: "打开源码…"; enabled: !root.interaction-busy; activated => { root.current-tab = 0; root.browse-source(); } }
            MenuItem { title: "打开固件…"; enabled: !root.interaction-busy && !root.debug-connected; activated => { root.browse-firmware(); } }
            MenuSeparator { }
            MenuItem { title: "保存项目"; enabled: !root.interaction-busy; activated => { root.save-project(); } }
        }
        Menu {
            title: "调试";
            MenuItem { title: "连接目标"; enabled: !root.debug-connected && !root.interaction-busy; activated => { root.debug-action(0); } }
            MenuItem { title: "断开连接"; enabled: root.debug-connected && !root.interaction-busy; activated => { root.debug-action(1); } }
            MenuSeparator { }
            MenuItem { title: "开始 / 继续"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(2); } }
            MenuItem { title: "暂停"; enabled: root.debug-running && !root.interaction-busy; activated => { root.debug-action(3); } }
            MenuItem { title: "步过"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(4); } }
            MenuItem { title: "步入"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(5); } }
            MenuItem { title: "步出"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(6); } }
            MenuItem { title: "复位目标"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(7); } }
            MenuItem { title: "下载固件"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(8); } }
            MenuSeparator { }
            MenuItem { title: "断点记录…"; enabled: !root.interaction-busy; activated => { root.show-breakpoints(); } }
        }
        Menu {
            title: "波形";
            MenuItem {
                title: "显示波形页";
                enabled: !root.interaction-busy;
                activated => { root.current-tab = 1; }
            }
            MenuItem {
                title: root.waveform-detached ? "关闭波形独立窗口" : "打开波形独立窗口";
                enabled: !root.interaction-busy;
                activated => { root.toggle-waveform-window(!root.waveform-detached); }
            }
            MenuItem {
                title: root.acquisition-active ? "停止波形采集" : "开始波形采集";
                enabled: !root.interaction-busy && (root.acquisition-active || (root.waveform-channels.length > 0 && (!root.acquisition-uses-session || root.debug-connected)));
                activated => { if root.acquisition-active { root.stop-acquisition(); } else { root.start-acquisition(); } }
            }
            MenuSeparator { }
            MenuItem { title: "保存当前图表为 CSV…"; enabled: !root.interaction-busy; activated => { root.export-waveform-csv(); } }
            MenuItem { title: "清空当前图表历史波形"; enabled: !root.interaction-busy; activated => { root.clear-waveform-history(); } }
        }
        Menu {
            title: "设置";
            MenuItem { title: "选择后端"; enabled: !root.interaction-busy; activated => { root.settings-tab = 0; root.settings-message = ""; root.settings-open = true; } }
            MenuItem { title: "安装后端"; enabled: !root.interaction-busy; activated => { root.settings-tab = 1; root.settings-message = ""; root.settings-open = true; } }
            MenuItem { title: "刷新率"; enabled: !root.interaction-busy; activated => { root.settings-tab = 3; root.settings-message = ""; root.settings-open = true; } }
            MenuItem { title: "调试设置"; enabled: !root.interaction-busy; activated => { root.settings-tab = 2; root.settings-message = ""; root.settings-open = true; } }
        }
    }
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 82px;
            background: Theme.sidebar;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                HorizontalLayout {
                    width: 264px;
                    spacing: 12px;
                    Image { source: @image-url("../assets/logo.svg"); width: 42px; height: 42px; image-fit: contain; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "NYA /"; font-weight: 800; font-size: 22px; color: Theme.accent; }
                        Text { text: "Embedded Debug Studio"; font-size: 11px; color: Theme.muted; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Button { text: "▶ 继续"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(2); } }
                        Button { text: "Ⅱ 暂停"; enabled: root.debug-running && !root.interaction-busy; clicked => { root.debug-action(3); } }
                        Button { text: "■ 停止"; enabled: root.debug-connected && !root.interaction-busy; clicked => { root.debug-action(1); } }
                        Rectangle { width: 1px; background: Theme.border; }
                        Button { text: "↷ 步过"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(4); } }
                        Button { text: "↓ 步入"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(5); } }
                        Button { text: "↑ 步出"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(6); } }
                        Button { text: "↻ 复位"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(7); } }
                    }
                }
                VerticalLayout {
                    width: 264px;
                    alignment: center;
                    Text { text: root.backend-summary; color: Theme.accent; font-size: 11px; overflow: elide; horizontal-alignment: right; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Text { text: "● " + root.debug-state; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                        Button { text: root.debug-connected ? "断开" : "连接"; enabled: !root.interaction-busy; clicked => { root.debug-action(root.debug-connected ? 1 : 0); } }
                        Button { text: "下载"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(8); } }
                    }
                }
            }
        }
        HorizontalLayout {
            padding: 10px;
            spacing: 0px;
            left-panel := Rectangle {
                width: root.left-panel-width;
                background: Theme.sidebar;
                border-radius: 16px;
                FirmwarePage {
                    padding: 16px;
                    busy: root.interaction-busy || root.debug-connected;
                    path <=> root.firmware-path;
                    title: root.firmware-title;
                    tree: root.firmware-tree;
                    tree-label-width: root.firmware-tree-label-width * 1px;
                    tree-content-width: root.firmware-tree-content-width * 1px;
                    details: root.firmware-details;
                    selected-node: root.firmware-selected-node;
                    functions-visible <=> root.functions-visible;
                    search-query <=> root.firmware-search;
                    search(query) => { root.search-firmware(query); }
                    select-node(index) => { root.select-firmware-node(index); }
                    select-file(index) => { root.select-firmware-file(index); }
                    open-source-file(path) => { root.open-tree-source(path); }
                    add-variable(index) => { root.add-firmware-variable(index); }
                    plot-variable(index) => { root.plot-variable(index); }
                    show-functions(show) => { root.show-functions(show); }
                    open => { root.open-firmware(); }
                    browse => { root.browse-firmware(); }
                }
            }
            PanelDivider {
                drag-start => { root.drag-panel-width = left-panel.width; }
                drag(delta) => {
                    root.left-panel-width = max(260px, min(root.drag-panel-width + delta, root.width - 40px - 360px - right-panel.width));
                }
            }
            Rectangle {
                background: Theme.background;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    TabWidget {
                        current-index <=> root.current-tab;
                        Tab {
                            title: "源码";
                            SourcePage {
                                padding-top: 12px;
                                busy: root.interaction-busy;
                                tabs: root.source-tabs;
                                selected-tab: root.source-selected-tab;
                                line-count: root.source-line-count;
                                halted: root.debug-halted;
                                breakpoints: root.source-breakpoints;
                                executable-lines: root.source-executable-lines;
                                line-hint: root.source-line-hint;
                                firmware-matches: root.firmware-title != "尚未打开编译产物" && root.firmware-path == root.firmware-title;
                                toggle-breakpoint(line) => { root.toggle-source-breakpoint(line); }
                                select-tab(index) => { root.select-source-tab(index); }
                                close-tab(index) => { root.close-source-tab(index); }
                                path <=> root.source-path;
                                source-title: root.source-title;
                                metadata: root.source-meta + (root.execution-location != "" ? " · " + root.execution-location : "");
                                source-text: root.source-text;
                                open => { root.open-source(); }
                                browse => { root.browse-source(); }
                            }
                        }
                        Tab {
                            title: "波形";
                            WaveformsPage {
                                padding-top: 12px;
                                detached: root.waveform-detached;
                                toggle-detached(detached) => { root.toggle-waveform-window(detached); }
                                channels: root.waveform-channels;
                                charts: root.waveform-charts;
                                selected-chart: root.waveform-selected-chart;
                                plot: root.waveform-plot;
                                axis-channels: root.waveform-axis-channels;
                                axis-index: root.waveform-axis-index;
                                y-ticks: root.waveform-y-ticks;
                                time-ticks: root.waveform-time-ticks;
                                zoom-label: root.waveform-zoom-label;
                                zoom(up, control, alt) => { root.zoom-waveform(up, control, alt); }
                                select-axis(index) => { root.select-waveform-axis(index); }
                                add-chart => { root.add-waveform-chart(); }
                                select-chart(index) => { root.select-waveform-chart(index); }
                                move-channel(watch, node, chart) => { root.move-waveform-channel(watch, node, chart); }
                                export-csv => { root.export-waveform-csv(); }
                                clear-history => { root.clear-waveform-history(); }
                                active: root.acquisition-active;
                                status: root.acquisition-status;
                                statistics: root.acquisition-statistics;
                                endpoint <=> root.acquisition-endpoint;
                                source-label: root.acquisition-source-label;
                                use-session: root.acquisition-uses-session;
                                session-ready: root.debug-connected;
                                start => { root.start-acquisition(); }
                                stop => { root.stop-acquisition(); }
                                remove(index, node) => { root.toggle-waveform(index, node); }
                            }
                        }
                        Tab {
                            title: "段 / 节 / 符号";
                            VerticalLayout {
                                padding-top: 12px;
                                spacing: 10px;
                                Text { text: root.firmware-title; color: Theme.text; overflow: elide; }
                                Text { text: root.firmware-meta; color: Theme.muted; wrap: word-wrap; }
                                TextEdit { text: root.firmware-report; read-only: true; wrap: no-wrap; font-family: "monospace"; vertical-stretch: 1; }
                            }
                        }
                        Tab {
                            title: "调试";
                            DebugPage {
                                busy: root.interaction-busy;
                                connected: root.debug-connected;
                                halted: root.debug-halted;
                                state-label: root.debug-state;
                                frames: root.stack-frames;
                                breakpoints: root.breakpoints;
                                log: root.debug-log;
                                action(kind) => { root.debug-action(kind); }
                                add-breakpoint(location) => { root.add-breakpoint(location); }
                                remove-breakpoint(id) => { root.remove-breakpoint(id); }
                                select-frame(level) => { root.select-frame(level); }
                            }
                        }
                    }
                }
            }
            PanelDivider {
                drag-start => { root.drag-panel-width = right-panel.width; }
                drag(delta) => {
                    root.right-panel-width = max(330px, min(root.drag-panel-width - delta, root.width - 40px - 360px - left-panel.width));
                }
            }
            right-panel := Rectangle {
                width: root.right-panel-width;
                background: Theme.sidebar;
                border-radius: 16px;
                VariablesPage {
                    padding: 16px;
                    watches: root.watches;
                    acquisition-active: root.acquisition-active;
                    memory-endpoint <=> root.acquisition-endpoint;
                    source-label: root.acquisition-source-label;
                    use-session: root.acquisition-uses-session;
                    session-ready: root.debug-connected;
                    live-enabled <=> root.live-enabled;
                    live-interval-index <=> root.live-interval-index;
                    live-custom-hz <=> root.live-custom-hz;
                    frequency-error: root.live-frequency-error;
                    sample-status: root.watch-sample-status;
                    live-refresh => { root.live-refresh(); }
                    revision: root.watch-revision;
                    can-write: root.debug-connected && !root.interaction-busy;
                    write(entry, node, value) => { root.write-watch(entry, node, value); }
                    add(expression) => { root.add-expression(expression); }
                    remove(index) => { root.remove-watch(index); }
                    toggle-waveform(index, node) => { root.toggle-waveform(index, node); }
                    toggle(entry, node) => { root.toggle-watch(entry, node); }
                }
            }
        }
        Rectangle {
            height: 34px;
            background: Theme.sidebar;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;
                Text { text: root.status; color: Theme.muted; overflow: elide; horizontal-stretch: 1; }
                Text { text: root.busy ? "处理中" : root.debug-state; color: Theme.accent; font-size: 12px; }
            }
        }
    }
    if root.settings-open: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #000a;
        TouchArea { }
        Rectangle {
            width: min(900px, root.width - 48px); height: min(680px, root.height - 48px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.sidebar; border-radius: 20px;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    Text { text: "设置"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-stretch: 1; }
                    Button { text: "关闭"; enabled: !root.busy && !root.file-dialog-open; clicked => { root.settings-open = false; } }
                }
                if root.settings-message != "": Text { text: root.settings-message; color: Theme.accent; wrap: word-wrap; }
                TabWidget {
                    current-index <=> root.settings-tab;
                    Tab {
                        title: "选择后端";
                        SelectToolsPage {
                            padding-top: 12px;
                            busy: root.busy || root.file-dialog-open;
                            tools: root.tools;
                            connected: root.debug-connected;
                            backend-summary: root.backend-summary;
                            message: root.tool-message;
                            refresh => { root.refresh-tools(); }
                            select-tool(kind, version) => { root.select-tool(kind, version); }
                        }
                    }
                    Tab {
                        title: "安装后端";
                        InstallToolsPage {
                            padding-top: 12px;
                            busy: root.busy || root.file-dialog-open;
                            tools: root.tools;
                            connected: root.debug-connected;
                            message: root.tool-message;
                            local-directory <=> root.local-tool-directory;
                            refresh => { root.refresh-tools(); }
                            install(kind, version) => { root.install-tool(kind, version); }
                            uninstall(kind, version) => { root.uninstall-tool(kind, version); }
                            add-local(kind, name, directory) => { root.add-local-tool(kind, name, directory); }
                            remove-local(kind, version) => { root.remove-local-tool(kind, version); }
                            browse-local => { root.browse-local-tool(); }
                        }
                    }
                    Tab {
                        title: "调试器设置";
                        DebugSettings {
                            busy: root.busy || root.file-dialog-open;
                            connected: root.debug-connected;
                            backend: root.backend-summary;
                            gdb-path <=> root.gdb-path;
                            target <=> root.debug-target;
                            backend-kind: root.backend-kind;
                            targets: root.targets;
                            packs: root.packs;
                            target-message: root.target-message;
                            target-search <=> root.target-search;
                            refresh-targets => { root.refresh-targets(); }
                            search-targets(query) => { root.search-targets(query); }
                            add-pack => { root.add-pack(); }
                            remove-pack(path) => { root.remove-pack(path); }
                            install-pack(part) => { root.install-pack(part); }
                            interface <=> root.debug-interface;
                            probes: root.probes;
                            probe-message: root.probe-message;
                            probe-search <=> root.probe-search;
                            search-probes(query) => { root.search-probes(query); }
                            browse-probe => { root.browse-probe(); }
                            port <=> root.debug-port;
                            firmware <=> root.firmware-path;
                            external-server <=> root.external-server;
                            browse-firmware => { root.browse-firmware(); }
                        }
                    }
                    Tab {
                        title: "刷新率";
                        VerticalLayout {
                            padding-top: 16px;
                            spacing: 12px;
                            Text { text: "数据界面刷新率"; color: Theme.text; font-size: 16px; }
                            ComboBox {
                                model: ["最高 · 1000 Hz", "100 Hz", "60 Hz", "30 Hz", "10 Hz", "2 Hz"];
                                current-index <=> root.refresh-rate-index;
                                selected => { root.refresh-rate-changed(); }
                            }
                            Text { text: "控制变量和波形界面的更新频率，不改变后端采样频率。"; color: Theme.muted; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }
        }
    }
    if root.project-dialog-open: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #000a;
        TouchArea { }
        Rectangle {
            width: 700px; height: 460px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.sidebar; border-radius: 20px;
            VerticalLayout {
                padding: 28px; spacing: 16px;
                Text { text: "打开项目"; color: Theme.text; font-size: 22px; font-weight: 700; }
                Text { text: "新建项目，或从历史记录中继续。"; color: Theme.muted; }
                Text { text: "历史项目"; color: Theme.text; font-weight: 600; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        if root.project-history.length == 0: Text { text: "暂无历史项目"; color: Theme.muted; }
                        for path in root.project-history: HorizontalLayout {
                            spacing: 8px;
                            Text { text: path; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            Button { text: "打开"; enabled: !root.busy && !root.file-dialog-open; clicked => { root.open-project(path); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "新建项目"; enabled: !root.busy && !root.file-dialog-open; clicked => { root.new-project(); } }
                    Button { text: "浏览项目文件…"; enabled: !root.busy && !root.file-dialog-open; clicked => { root.browse-project(); } }
                }
                Text { text: root.status; color: Theme.muted; wrap: word-wrap; }
            }
        }
    }
}


export component BreakpointWindow inherits Window {
    title: "断点记录";
    preferred-width: 700px;
    preferred-height: 420px;
    background: Theme.background;
    in property <[BreakpointRow]> breakpoints;
    in property <bool> can-edit;
    in property <bool> can-edit-pending;
    callback set-enabled(string, bool);
    callback remove(string);
    VerticalLayout {
        padding: 16px; spacing: 10px;
        Text { text: "断点记录"; color: Theme.text; font-size: 18px; font-weight: 700; }
        Text { text: root.breakpoints.length == 0 ? "当前没有断点" : "待设置断点可提前管理；已设置断点请在目标暂停后操作"; color: Theme.muted; }
        ListView {
            vertical-stretch: 1;
            for bp in root.breakpoints: HorizontalLayout {
                height: 42px; spacing: 8px;
                Text { text: bp.label; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: bp.enabled ? "禁用" : "启用"; enabled: root.can-edit || (bp.pending && root.can-edit-pending); clicked => { root.set-enabled(bp.id, !bp.enabled); } }
                Button { text: "删除"; enabled: root.can-edit || (bp.pending && root.can-edit-pending); clicked => { root.remove(bp.id); } }
            }
        }
    }
}

export component WaveformWindow inherits Window {
    title: "实时波形";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 600px;
    min-height: 480px;
    background: Theme.background;
    in property <[WaveformRow]> channels;
    in property <[string]> charts;
    in property <int> selected-chart;
    in property <image> plot;
    in property <[string]> axis-channels;
    in property <int> axis-index;
    in property <[string]> y-ticks;
    in property <[string]> time-ticks;
    in property <string> zoom-label;
    callback zoom(bool, bool, bool);
    callback select-axis(int);
    in property <bool> active;
    in property <string> status;
    in property <string> statistics;
    in-out property <string> endpoint;
    in property <string> source-label;
    in property <bool> use-session;
    in property <bool> session-ready;
    callback toggle-detached(bool);
    callback add-chart();
    callback select-chart(int);
    callback move-channel(int, int, int);
    callback export-csv();
    callback clear-history();
    callback start();
    callback stop();
    callback remove(int, int);
    callback endpoint-edited(string);
    changed endpoint => { root.endpoint-edited(root.endpoint); }
    WaveformsPage {
        padding: 12px;
        detached: true;
        channels: root.channels;
        charts: root.charts;
        selected-chart: root.selected-chart;
        plot: root.plot;
        axis-channels: root.axis-channels;
        axis-index: root.axis-index;
        y-ticks: root.y-ticks;
        time-ticks: root.time-ticks;
        zoom-label: root.zoom-label;
        zoom(up, control, alt) => { root.zoom(up, control, alt); }
        select-axis(index) => { root.select-axis(index); }
        active: root.active;
        status: root.status;
        statistics: root.statistics;
        endpoint <=> root.endpoint;
        source-label: root.source-label;
        use-session: root.use-session;
        session-ready: root.session-ready;
        toggle-detached(value) => { root.toggle-detached(value); }
        add-chart => { root.add-chart(); }
        select-chart(index) => { root.select-chart(index); }
        move-channel(watch, node, chart) => { root.move-channel(watch, node, chart); }
        export-csv => { root.export-csv(); }
        clear-history => { root.clear-history(); }
        start => { root.start(); }
        stop => { root.stop(); }
        remove(watch, node) => { root.remove(watch, node); }
    }
}

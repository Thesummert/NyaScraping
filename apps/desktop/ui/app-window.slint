import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, SpinBox, TabWidget, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ConnectionButton } from "components/connection-button.slint";
import { SourcePage, SourceTab, SourceBreakpoint, HighlightLine, HighlightSpan } from "pages/source.slint";
import { InstallToolsPage, SelectToolsPage, ToolRow } from "pages/tools.slint";
import { VariablesPage, WatchRow } from "pages/variables.slint";
import { WaveformsPage, WaveformRow, WaveformPath } from "pages/waveforms.slint";
import { FirmwarePage, FirmwareTreeRow } from "pages/firmware.slint";
import { DebugPage, FrameRow, BreakpointRow } from "pages/debug.slint";
import { DebugSettings } from "pages/debug-settings.slint";
import { TargetRow, PackRow } from "pages/target-selector.slint";
export { SourceTab, SourceBreakpoint, HighlightLine, HighlightSpan, FirmwareTreeRow, WatchRow, ToolRow, FrameRow, BreakpointRow, TargetRow, PackRow, WaveformRow, WaveformPath }

component PanelDivider inherits Rectangle {
    callback drag-start();
    callback drag(length);
    width: 10px;
    background: transparent;
    Rectangle {
        width: 2px;
        height: 40px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 1px;
        background: handle.has-hover || handle.pressed ? Theme.accent : Theme.border;
        animate background { duration: 140ms; }
    }
    handle := TouchArea {
        property <length> start-x;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.start-x = self.absolute-position.x + self.mouse-x;
                root.drag-start();
            }
        }
        moved => {
            if self.pressed {
                root.drag(self.absolute-position.x + self.mouse-x - self.start-x);
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "NyaScraping · Embedded Debug Studio";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1480px;
    preferred-height: 900px;
    min-width: 1180px;
    min-height: 720px;
    background: Theme.background;
    default-font-size: 14px;

    in-out property <bool> busy: false;
    in-out property <bool> firmware-parsing: false;
    in-out property <string> firmware-parse-path;
    in-out property <string> firmware-parse-stage;
    in-out property <string> firmware-parse-details;
    in-out property <float> firmware-parse-progress;
    callback begin-firmware-parse(string);
    in-out property <bool> file-dialog-open: false;
    in-out property <bool> project-dialog-open: true;
    in-out property <[string]> project-history;
    in-out property <string> project-path;
    callback new-project();
    callback open-project(string);
    callback browse-project();
    callback save-project();
    in-out property <bool> settings-open: false;
    in-out property <bool> firmware-update-open: false;
    in-out property <string> firmware-update-path;
    callback respond-firmware-update(bool);
    in-out property <int> settings-tab: 0;
    in-out property <string> settings-message;
    in-out property <int> refresh-rate-index: 0;
    in-out property <bool> show-fps: false;
    callback show-fps-changed(bool);
    in-out property <bool> hardware-rendering: true;
    callback hardware-rendering-changed(bool);
    callback refresh-rate-changed();
    in-out property <image> background-image;
    in-out property <bool> background-active: false;
    in-out property <int> background-opacity: 35;
    private property <bool> background-shown: root.background-active && root.background-opacity > 0;
    in-out property <string> background-path-draft;
    in-out property <int> background-opacity-draft: 35;
    in-out property <int> background-blur-draft: 8;
    in-out property <bool> background-loading: false;
    in-out property <image> background-preview-image;
    in-out property <bool> background-preview-ready: false;
    in-out property <string> background-preview-message: "选择图片以预览";
    callback browse-background();
    callback apply-background();
    callback clear-background();
    callback background-changed();
    callback preview-background();
    changed background-path-draft => { root.preview-background(); }
    changed background-blur-draft => { root.preview-background(); }
    changed settings-open => { root.preview-background(); }
    changed settings-tab => { root.preview-background(); }
    private property <bool> interaction-busy: root.busy || root.firmware-parsing || root.file-dialog-open || root.project-dialog-open || root.settings-open || root.firmware-update-open;
    in-out property <bool> workspace-expanded: false;
    private property <bool> file-tree-visible: true;
    private property <float> file-tree-reveal: root.file-tree-visible ? 1 : 0;
    animate file-tree-reveal { duration: 240ms; easing: ease-out; }
    private property <length> left-panel-width: 280px;
    private property <length> right-panel-width: 330px;
    private property <length> drag-panel-width;
    changed width => {
        root.left-panel-width = min(root.left-panel-width, max(260px, root.width - 54px - 360px - 330px));
        root.right-panel-width = min(root.right-panel-width, max(330px, root.width - 54px - 360px - root.left-panel-width));
    }
    in-out property <bool> debug-connected: false;
    in-out property <bool> debug-halted: false;
    in-out property <bool> debug-running: false;
    in-out property <string> debug-state: "未连接";
    in-out property <string> gdb-path: "arm-none-eabi-gdb";
    in-out property <string> debug-target;
    in-out property <int> backend-kind: -1;
    in-out property <[TargetRow]> targets;
    in-out property <[PackRow]> packs;
    in-out property <string> target-message: "请先选择调试后端";
    in-out property <string> target-search;
    callback refresh-targets();
    callback search-targets(string);
    callback add-pack();
    callback remove-pack(string);
    callback install-pack(string);
    in-out property <string> debug-interface;
    in-out property <int> debug-transport-index: 0;
    in-out property <[TargetRow]> probes;
    in-out property <string> probe-message;
    in-out property <string> probe-search;
    callback search-probes(string);
    callback browse-probe();
    in-out property <string> debug-port: "3333";
    in-out property <bool> external-server: false;
    in-out property <[FrameRow]> stack-frames;
    in-out property <[BreakpointRow]> breakpoints;
    in-out property <string> debug-log;
    in-out property <string> execution-location;
    in-out property <int> source-execution-line;
    callback reveal-execution-line();
    reveal-execution-line => { source-page.reveal-execution-line(); }
    callback debug-action(int);
    callback add-breakpoint(string);
    callback remove-breakpoint(string);
    callback toggle-source-breakpoint(int);
    callback show-breakpoints();
    callback select-frame(int);
    in-out property <int> current-tab: 0;
    in-out property <string> status: "就绪";
    callback status-message-changed(string);
    callback record-system-error(string);
    callback acquisition-message-changed(string);
    callback debug-output-changed(string);
    callback show-system-log();
    changed status => { root.status-message-changed(root.status); }
    changed acquisition-status => { root.acquisition-message-changed(root.acquisition-status); }
    changed debug-log => { root.debug-output-changed(root.debug-log); }
    in-out property <[ToolRow]> tools;
    in-out property <string> backend-summary: "尚未选择调试后端";
    in-out property <string> tool-message: "扫描 PATH 工具与已安装版本。";
    in-out property <[SourceTab]> source-tabs;
    in-out property <int> source-selected-tab: -1;
    callback select-source-tab(int);
    callback close-source-tab(int);
    callback open-tree-source(string);
    in-out property <string> source-path;
    in-out property <string> source-title: "尚未打开文件";
    in-out property <string> source-meta: "";
    in-out property <string> source-text: "打开一个源码文件以开始浏览。";
    in-out property <string> source-font-family: "monospace";
    in-out property <int> source-font-size: 14;
    in-out property <string> source-font-draft: "monospace";
    in-out property <int> source-font-size-draft: 14;
    out property <length> source-editor-x: source-page.editor-x;
    out property <length> source-editor-y: source-page.editor-y;
    out property <length> source-editor-width: source-page.editor-width;
    out property <length> source-editor-height: source-page.editor-height;
    callback apply-source-font();
    callback source-font-changed();
    in-out property <[HighlightLine]> source-highlights;
    in-out property <bool> source-highlight-enabled: true;
    in-out property <int> source-highlight-width;
    in-out property <string> source-highlight-status;
    callback highlight-source();
    in-out property <int> source-line-count;
    in-out property <[SourceBreakpoint]> source-breakpoints;
    in-out property <[bool]> source-executable-lines;
    in-out property <string> source-line-hint;
    in-out property <string> firmware-path;
    in-out property <string> firmware-title: "尚未打开编译产物";
    in-out property <string> firmware-meta;
    in-out property <string> firmware-report: "解析编译产物后，在这里查看段、节与符号表。";
    in-out property <[FirmwareTreeRow]> firmware-tree;
    in-out property <int> firmware-tree-label-width;
    in-out property <int> firmware-tree-content-width;
    in-out property <int> firmware-selected-node: -1;
    in-out property <string> firmware-details: "选择文件树中的函数或变量，查看类型、声明位置及存储位置。";
    in-out property <bool> functions-visible: false;
    in-out property <[WatchRow]> watches;
    in-out property <int> watch-name-width: 72;
    in-out property <int> watch-type-width: 76;
    in-out property <int> watch-value-width: 68;
    in-out property <[WaveformRow]> waveform-channels;
    in-out property <[string]> waveform-charts: ["图表 1"];
    in-out property <int> waveform-selected-chart: 0;
    in-out property <[WaveformPath]> waveform-paths;
    in-out property <[string]> waveform-axis-channels;
    in-out property <int> waveform-axis-index;
    in-out property <[string]> waveform-y-ticks: ["—", "—", "—", "—", "—"];
    in-out property <[string]> waveform-time-ticks: ["-5 s", "-3.75 s", "-2.5 s", "-1.25 s", "0 s"];
    in-out property <string> waveform-zoom-label;
    callback zoom-waveform(bool, bool, bool);
    callback select-waveform-axis(int);
    in-out property <bool> waveform-detached: false;
    callback toggle-waveform-window(bool);
    callback add-waveform-chart();
    callback select-waveform-chart(int);
    callback move-waveform-channel(int, int, int);
    callback export-waveform-csv();
    callback clear-waveform-history();
    in-out property <bool> acquisition-active: false;
    in-out property <string> acquisition-status: "采集未启动";
    in-out property <string> acquisition-statistics: "每通道最多保留 32768 个样本；尚无采集数据";
    in-out property <string> acquisition-endpoint: "127.0.0.1:6666";
    out property <bool> acquisition-uses-session: root.backend-kind == 1 || root.backend-kind == 2;
    out property <string> acquisition-source-label: root.backend-kind == 1 ? "pyOCD · 调试会话" : root.backend-kind == 2 ? "probe-rs · 调试会话" : "OpenOCD Tcl";
    callback refresh-tools();
    in-out property <string> tree-sitter-executable;
    in-out property <string> tree-sitter-config;
    in-out property <string> tree-sitter-message: "尚未检测";
    in-out property <bool> tree-sitter-busy: false;
    callback tree-sitter-event(string);
    changed tree-sitter-message => { root.tree-sitter-event(root.tree-sitter-message); }
    callback tree-sitter-detect();
    callback tree-sitter-save();
    callback tree-sitter-install();
    callback tree-sitter-languages();
    callback install-tool(int, string);
    callback select-tool(int, string);
    callback uninstall-tool(int, string);
    callback add-local-tool(int, string, string);
    callback remove-local-tool(int, string);
    callback browse-local-tool();
    in-out property <string> local-tool-directory;
    callback open-source();
    callback open-firmware();
    callback browse-source();
    callback browse-firmware();
    callback select-firmware-node(int);
    callback select-firmware-file(int);
    callback add-firmware-variable(int);
    callback add-expression(string);
    callback remove-watch(int);
    callback plot-variable(int);
    callback toggle-waveform(int, int);
    callback start-acquisition();
    callback stop-acquisition();
    callback toggle-watch(int, int);
    callback show-functions(bool);
    in-out property <string> firmware-search;
    callback search-firmware(string);
    in-out property <bool> live-enabled: false;
    in-out property <int> live-interval-index: 5;
    in-out property <string> live-custom-hz: "10";
    in-out property <string> live-frequency-error;
    in-out property <string> watch-sample-status: "实时刷新已关闭";
    callback live-refresh();
    in-out property <int> watch-revision;
    callback write-watch(int, int, string);

    MenuBar {
        Menu {
            title: "文件";
            MenuItem { title: "打开项目…"; enabled: !root.interaction-busy && !root.debug-connected; activated => { root.browse-project(); } }
            MenuItem { title: "打开源码…"; enabled: !root.interaction-busy; activated => { root.current-tab = 0; root.browse-source(); } }
            MenuItem { title: "打开固件…"; enabled: !root.interaction-busy && !root.debug-connected; activated => { root.browse-firmware(); } }
            MenuSeparator { }
            MenuItem { title: "保存项目"; enabled: !root.interaction-busy; activated => { root.save-project(); } }
        }
        Menu {
            title: "调试";
            MenuItem { title: "连接目标"; enabled: !root.debug-connected && !root.interaction-busy; activated => { root.debug-action(0); } }
            MenuItem { title: "断开连接"; enabled: root.debug-connected && !root.interaction-busy; activated => { root.debug-action(1); } }
            MenuSeparator { }
            MenuItem { title: "开始 / 继续"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(2); } }
            MenuItem { title: "暂停"; enabled: root.debug-running && !root.interaction-busy; activated => { root.debug-action(3); } }
            MenuItem { title: "步过"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(4); } }
            MenuItem { title: "步入"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(5); } }
            MenuItem { title: "步出"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(6); } }
            MenuItem { title: "复位目标"; enabled: root.debug-halted && !root.interaction-busy; activated => { root.debug-action(7); } }
            MenuItem { title: "下载固件"; enabled: (!root.debug-connected || root.debug-halted || root.debug-running) && !root.interaction-busy; activated => { root.debug-action(8); } }
            MenuSeparator { }
            MenuItem { title: "断点记录…"; enabled: !root.interaction-busy; activated => { root.show-breakpoints(); } }
        }
        Menu {
            title: "波形";
            MenuItem {
                title: "显示波形页";
                enabled: !root.interaction-busy;
                activated => { root.current-tab = 1; }
            }
            MenuItem {
                title: root.waveform-detached ? "关闭波形独立窗口" : "打开波形独立窗口";
                enabled: !root.interaction-busy;
                activated => { root.toggle-waveform-window(!root.waveform-detached); }
            }
            MenuItem {
                title: root.acquisition-active ? "停止波形采集" : "开始波形采集";
                enabled: !root.interaction-busy && (root.acquisition-active || (root.waveform-channels.length > 0 && (!root.acquisition-uses-session || root.debug-connected)));
                activated => { if root.acquisition-active { root.stop-acquisition(); } else { root.start-acquisition(); } }
            }
            MenuSeparator { }
            MenuItem { title: "保存当前图表为 CSV…"; enabled: !root.interaction-busy; activated => { root.export-waveform-csv(); } }
            MenuItem { title: "清空当前图表历史波形"; enabled: !root.interaction-busy; activated => { root.clear-waveform-history(); } }
        }
        Menu {
            title: "视图";
            MenuItem { title: root.file-tree-visible ? "隐藏文件树" : "显示文件树"; enabled: !root.interaction-busy && !root.workspace-expanded; activated => { root.file-tree-visible = !root.file-tree-visible; } }
            MenuItem { title: root.workspace-expanded ? "恢复三栏布局" : "扩大源码 / 波形区域"; enabled: !root.interaction-busy; activated => { root.workspace-expanded = !root.workspace-expanded; } }
        }
        Menu {
            title: "设置";
            MenuItem { title: "选择后端"; enabled: !root.interaction-busy; activated => { root.settings-tab = 0; root.settings-message = ""; root.settings-open = true; } }
            MenuItem { title: "安装后端"; enabled: !root.interaction-busy; activated => { root.settings-tab = 1; root.settings-message = ""; root.settings-open = true; } }
            MenuItem { title: "刷新率"; enabled: !root.interaction-busy; activated => { root.settings-tab = 3; root.settings-message = ""; root.settings-open = true; } }
            MenuItem { title: "调试设置"; enabled: !root.interaction-busy; activated => { root.settings-tab = 2; root.settings-message = ""; root.settings-open = true; } }
            MenuItem { title: "Tree-sitter 管理"; enabled: !root.interaction-busy; activated => { root.settings-tab = 4; root.settings-message = ""; root.settings-open = true; } }
            MenuItem { title: "源码字体"; enabled: !root.interaction-busy; activated => { root.source-font-draft = root.source-font-family; root.source-font-size-draft = root.source-font-size; root.settings-tab = 5; root.settings-message = ""; root.settings-open = true; } }
            MenuItem { title: "自定义背景"; enabled: !root.interaction-busy; activated => { root.settings-tab = 6; root.settings-message = ""; root.settings-open = true; } }
        }
    }
    if root.background-active: Image {
        width: root.width; height: root.height;
        source: root.background-image;
        image-fit: cover;
        opacity: root.background-opacity * 0.01;
    }
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 82px;
            background: root.background-shown ? #191c2980 : Theme.sidebar;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                HorizontalLayout {
                    width: 264px;
                    spacing: 12px;
                    Image { source: @image-url("../assets/logo.svg"); width: 42px; height: 42px; image-fit: contain; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "NYA /"; font-weight: 800; font-size: 22px; color: Theme.accent; }
                        Text { text: "Embedded Debug Studio"; font-size: 11px; color: Theme.muted; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Button { text: "▶ 继续"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(2); } }
                        Button { text: "Ⅱ 暂停"; enabled: root.debug-running && !root.interaction-busy; clicked => { root.debug-action(3); } }
                        Button { text: "■ 停止"; enabled: root.debug-connected && !root.interaction-busy; clicked => { root.debug-action(1); } }
                        Rectangle { width: 1px; background: Theme.border; }
                        Button { text: "↷ 步过"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(4); } }
                        Button { text: "↓ 步入"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(5); } }
                        Button { text: "↑ 步出"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(6); } }
                        Button { text: "↻ 复位"; enabled: root.debug-halted && !root.interaction-busy; clicked => { root.debug-action(7); } }
                    }
                }
                VerticalLayout {
                    width: 264px;
                    alignment: center;
                    Text { text: root.backend-summary; color: Theme.accent; font-size: 11px; overflow: elide; horizontal-alignment: right; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Text { text: "● " + root.debug-state; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                        ConnectionButton { connected: root.debug-connected; busy: root.interaction-busy; action(kind) => { root.debug-action(kind); } }
                        Button { text: "下载"; enabled: (!root.debug-connected || root.debug-halted || root.debug-running) && !root.interaction-busy; clicked => { root.debug-action(8); } }
                    }
                }
            }
        }
        HorizontalLayout {
            padding: 10px;
            spacing: 0px;
            left-panel := Rectangle {
                width: root.workspace-expanded ? 0px : root.left-panel-width * root.file-tree-reveal;
                visible: !root.workspace-expanded && root.file-tree-reveal > 0;
                clip: true;
                background: root.background-shown ? #191c2980 : Theme.sidebar;
                border-radius: 16px;
                FirmwarePage {
                    width: root.left-panel-width;
                    height: parent.height;
                    padding: 16px;
                    busy: root.interaction-busy || root.debug-connected;
                    custom-background: root.background-shown;
                    path <=> root.firmware-path;
                    title: root.firmware-title;
                    tree: root.firmware-tree;
                    tree-label-width: root.firmware-tree-label-width * 1px;
                    tree-content-width: root.firmware-tree-content-width * 1px;
                    details: root.firmware-details;
                    selected-node: root.firmware-selected-node;
                    functions-visible <=> root.functions-visible;
                    search-query <=> root.firmware-search;
                    search(query) => { root.search-firmware(query); }
                    select-node(index) => { root.select-firmware-node(index); }
                    select-file(index) => { root.select-firmware-file(index); }
                    open-source-file(path) => { root.open-tree-source(path); }
                    add-variable(index) => { root.add-firmware-variable(index); }
                    plot-variable(index) => { root.plot-variable(index); }
                    show-functions(show) => { root.show-functions(show); }
                    open => { root.open-firmware(); }
                    browse => { root.browse-firmware(); }
                }
            }
            Rectangle {
                width: root.workspace-expanded ? 0px : 24px;
                visible: !root.workspace-expanded;
                background: transparent;
                Rectangle {
                    x: 2px; y: 16px; width: 20px; height: 32px;
                    border-radius: 6px;
                    background: tree-toggle.has-hover ? Theme.panel : Theme.sidebar;
                    Text {
                        text: root.file-tree-visible ? "◀" : "▶";
                        color: tree-toggle.has-hover ? Theme.text : Theme.muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tree-toggle := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.file-tree-visible = !root.file-tree-visible; }
                    }
                }
                PanelDivider {
                    x: 7px; y: 48px; width: 10px; height: parent.height - 48px;
                    visible: root.file-tree-visible && root.file-tree-reveal >= 1;
                    drag-start => { root.drag-panel-width = left-panel.width; }
                    drag(delta) => {
                        root.left-panel-width = max(260px, min(root.drag-panel-width + delta, root.width - 54px - 360px - right-panel.width));
                    }
                }
            }
            Rectangle {
                background: root.background-shown ? transparent : Theme.background;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    TabWidget {
                        current-index <=> root.current-tab;
                        Tab {
                            title: "源码";
                            source-page := SourcePage {
                                padding-top: 12px;
                                busy: root.interaction-busy;
                                custom-background: root.background-shown;
                                tabs: root.source-tabs;
                                selected-tab: root.source-selected-tab;
                                line-count: root.source-line-count;
                                halted: root.debug-halted;
                                execution-line: root.source-execution-line;
                                breakpoints: root.source-breakpoints;
                                executable-lines: root.source-executable-lines;
                                line-hint: root.source-line-hint;
                                firmware-matches: root.firmware-title != "尚未打开编译产物" && root.firmware-path == root.firmware-title;
                                toggle-breakpoint(line) => { root.toggle-source-breakpoint(line); }
                                select-tab(index) => { root.select-source-tab(index); }
                                close-tab(index) => { root.close-source-tab(index); }
                                path <=> root.source-path;
                                source-title: root.source-title;
                                metadata: root.source-meta + (root.execution-location != "" ? " · " + root.execution-location : "") + (root.source-highlight-status != "" ? " · " + root.source-highlight-status : "");
                                source-text: root.source-text;
                                font-family: root.source-font-family;
                                font-size: root.source-font-size;
                                highlight-enabled <=> root.source-highlight-enabled;
                                highlight-lines: root.source-highlight-enabled ? root.source-highlights : [];
                                highlight-width: root.source-highlight-width;
                                open => { root.open-source(); }
                                browse => { root.browse-source(); }
                            }
                        }
                        Tab {
                            title: "波形";
                            WaveformsPage {
                                custom-background: root.background-shown;
                                padding-top: 12px;
                                detached <=> root.waveform-detached;
                                toggle-detached(detached) => { root.toggle-waveform-window(detached); }
                                channels: root.waveform-channels;
                                charts: root.waveform-charts;
                                selected-chart: root.waveform-selected-chart;
                                paths: root.waveform-paths;
                                axis-channels: root.waveform-axis-channels;
                                axis-index: root.waveform-axis-index;
                                y-ticks: root.waveform-y-ticks;
                                time-ticks: root.waveform-time-ticks;
                                zoom-label: root.waveform-zoom-label;
                                zoom(up, control, alt) => { root.zoom-waveform(up, control, alt); }
                                select-axis(index) => { root.select-waveform-axis(index); }
                                add-chart => { root.add-waveform-chart(); }
                                select-chart(index) => { root.select-waveform-chart(index); }
                                move-channel(watch, node, chart) => { root.move-waveform-channel(watch, node, chart); }
                                export-csv => { root.export-waveform-csv(); }
                                clear-history => { root.clear-waveform-history(); }
                                active: root.acquisition-active;
                                status: root.acquisition-status;
                                statistics: root.acquisition-statistics;
                                endpoint <=> root.acquisition-endpoint;
                                source-label: root.acquisition-source-label;
                                use-session: root.acquisition-uses-session;
                                session-ready: root.debug-connected;
                                start => { root.start-acquisition(); }
                                stop => { root.stop-acquisition(); }
                                remove(index, node) => { root.toggle-waveform(index, node); }
                            }
                        }
                        Tab {
                            title: "段 / 节 / 符号";
                            VerticalLayout {
                                padding-top: 12px;
                                spacing: 10px;
                                Text { text: root.firmware-title; color: Theme.text; overflow: elide; }
                                Text { text: root.firmware-meta; color: Theme.muted; wrap: word-wrap; }
                                TextEdit { text: root.firmware-report; read-only: true; wrap: no-wrap; font-family: "monospace"; vertical-stretch: 1; }
                            }
                        }
                        Tab {
                            title: "调试";
                            DebugPage {
                                busy: root.interaction-busy;
                                connected: root.debug-connected;
                                halted: root.debug-halted;
                                state-label: root.debug-state;
                                frames: root.stack-frames;
                                breakpoints: root.breakpoints;
                                log: root.debug-log;
                                action(kind) => { root.debug-action(kind); }
                                add-breakpoint(location) => { root.add-breakpoint(location); }
                                remove-breakpoint(id) => { root.remove-breakpoint(id); }
                                select-frame(level) => { root.select-frame(level); }
                            }
                        }
                    }
                }
            }
            PanelDivider {
                width: root.workspace-expanded ? 0px : 10px;
                visible: !root.workspace-expanded;
                drag-start => { root.drag-panel-width = right-panel.width; }
                drag(delta) => {
                    root.right-panel-width = max(330px, min(root.drag-panel-width - delta, root.width - 54px - 360px - root.left-panel-width));
                }
            }
            right-panel := Rectangle {
                width: root.workspace-expanded ? 0px : root.right-panel-width;
                visible: !root.workspace-expanded;
                clip: true;
                background: root.background-shown ? #191c2980 : Theme.sidebar;
                border-radius: 16px;
                VariablesPage {
                    padding: 16px;
                    watches: root.watches;
                    name-width: root.watch-name-width * 1px;
                    type-width: root.watch-type-width * 1px;
                    value-width: root.watch-value-width * 1px;
                    acquisition-active: root.acquisition-active;
                    memory-endpoint <=> root.acquisition-endpoint;
                    source-label: root.acquisition-source-label;
                    use-session: root.acquisition-uses-session;
                    session-ready: root.debug-connected;
                    live-enabled <=> root.live-enabled;
                    live-interval-index <=> root.live-interval-index;
                    live-custom-hz <=> root.live-custom-hz;
                    frequency-error: root.live-frequency-error;
                    sample-status: root.watch-sample-status;
                    live-refresh => { root.live-refresh(); }
                    revision: root.watch-revision;
                    can-write: root.debug-connected && !root.interaction-busy;
                    write(entry, node, value) => { root.write-watch(entry, node, value); }
                    add(expression) => { root.add-expression(expression); }
                    remove(index) => { root.remove-watch(index); }
                    toggle-waveform(index, node) => { root.toggle-waveform(index, node); }
                    toggle(entry, node) => { root.toggle-watch(entry, node); }
                }
            }
        }
        Rectangle {
            height: 34px;
            background: root.background-shown ? #191c2980 : Theme.sidebar;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;
                Rectangle {
                    horizontal-stretch: 1;
                    Text { text: root.status; color: status-hit.has-hover ? Theme.text : Theme.muted; animate color { duration: 140ms; } overflow: elide; vertical-alignment: center; }
                    status-hit := TouchArea { mouse-cursor: pointer; clicked => { root.show-system-log(); } }
                }
                Text { text: root.busy ? "处理中" : root.debug-state; color: Theme.accent; font-size: 12px; }
            }
        }
    }
    settings-overlay := Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        property <float> reveal: root.settings-open ? 1 : 0;
        animate reveal { duration: 240ms; easing: ease-out; }
        visible: root.settings-open || self.reveal > 0;
        background: #000a;
        TouchArea { }
        Rectangle {
            width: min(900px, root.width - 48px); height: min(680px, root.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1 - settings-overlay.reveal) * 24px;
            background: Theme.sidebar; border-radius: 20px;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    Text { text: "设置"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-stretch: 1; }
                    Button { text: "关闭"; enabled: !root.busy && !root.file-dialog-open; clicked => { root.settings-open = false; } }
                }
                if root.settings-message != "": Text { text: root.settings-message; color: Theme.accent; wrap: word-wrap; }
                TabWidget {
                    current-index <=> root.settings-tab;
                    Tab {
                        title: "选择后端";
                        SelectToolsPage {
                            padding-top: 12px;
                            busy: root.busy || root.file-dialog-open;
                            tools: root.tools;
                            connected: root.debug-connected;
                            backend-summary: root.backend-summary;
                            message: root.tool-message;
                            refresh => { root.refresh-tools(); }
                            select-tool(kind, version) => { root.select-tool(kind, version); }
                        }
                    }
                    Tab {
                        title: "安装后端";
                        InstallToolsPage {
                            padding-top: 12px;
                            busy: root.busy || root.file-dialog-open;
                            tools: root.tools;
                            connected: root.debug-connected;
                            message: root.tool-message;
                            local-directory <=> root.local-tool-directory;
                            refresh => { root.refresh-tools(); }
                            install(kind, version) => { root.install-tool(kind, version); }
                            uninstall(kind, version) => { root.uninstall-tool(kind, version); }
                            add-local(kind, name, directory) => { root.add-local-tool(kind, name, directory); }
                            remove-local(kind, version) => { root.remove-local-tool(kind, version); }
                            browse-local => { root.browse-local-tool(); }
                        }
                    }
                    Tab {
                        title: "调试器设置";
                        DebugSettings {
                            busy: root.busy || root.file-dialog-open;
                            connected: root.debug-connected;
                            backend: root.backend-summary;
                            gdb-path <=> root.gdb-path;
                            target <=> root.debug-target;
                            backend-kind: root.backend-kind;
                            targets: root.targets;
                            packs: root.packs;
                            target-message: root.target-message;
                            target-search <=> root.target-search;
                            refresh-targets => { root.refresh-targets(); }
                            search-targets(query) => { root.search-targets(query); }
                            add-pack => { root.add-pack(); }
                            remove-pack(path) => { root.remove-pack(path); }
                            install-pack(part) => { root.install-pack(part); }
                            interface <=> root.debug-interface;
                            transport-index <=> root.debug-transport-index;
                            probes: root.probes;
                            probe-message: root.probe-message;
                            probe-search <=> root.probe-search;
                            search-probes(query) => { root.search-probes(query); }
                            browse-probe => { root.browse-probe(); }
                            port <=> root.debug-port;
                            firmware <=> root.firmware-path;
                            external-server <=> root.external-server;
                            browse-firmware => { root.browse-firmware(); }
                        }
                    }
                    Tab {
                        title: "刷新率";
                        VerticalLayout {
                            padding-top: 16px;
                            spacing: 12px;
                            Text { text: "数据界面刷新率"; color: Theme.text; font-size: 16px; }
                            ComboBox {
                                model: ["最高 · 1000 Hz", "100 Hz", "60 Hz", "30 Hz", "10 Hz", "2 Hz"];
                                current-index <=> root.refresh-rate-index;
                                selected => { root.refresh-rate-changed(); }
                            }
                            Text { text: "控制变量界面的更新频率；波形绘制最高 60 帧/秒，不改变后端采样频率。"; color: Theme.muted; wrap: word-wrap; }
                            CheckBox {
                                text: "启用硬件渲染（重启后生效）";
                                checked <=> root.hardware-rendering;
                                toggled => { root.hardware-rendering-changed(self.checked); }
                            }
                            Text { text: "启用后使用 GPU 绘制波形曲线和界面；关闭后使用软件渲染。若 GPU 无法启动，可设置 SLINT_BACKEND=winit-software 启动并修改此设置。"; color: Theme.muted; wrap: word-wrap; }
                            CheckBox {
                                text: "显示每秒绘制帧数（重启后生效）";
                                checked <=> root.show-fps;
                                toggled => { root.show-fps-changed(self.checked); }
                            }
                            Text { text: "统计最近一秒实际绘制的帧数。界面静止时不会持续绘制；短动画结束后数值也会降低。请持续滚动或操作至少一秒再观察。"; color: Theme.muted; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Tab {
                        title: "Tree-sitter";
                        VerticalLayout {
                            padding-top: 16px; spacing: 12px;
                            Text { text: "Tree-sitter 命令行工具"; color: Theme.text; font-size: 16px; }
                            Text { text: "源码使用已配置语言的高亮规则；此处尚不支持安装语言解析器。"; color: Theme.muted; wrap: word-wrap; }
                            Text { text: "留空时优先使用应用安装的版本，再从 PATH 查找。也可输入本机可执行文件的完整路径。"; color: Theme.muted; wrap: word-wrap; }
                            LineEdit { text <=> root.tree-sitter-executable; placeholder-text: "可执行文件路径（留空自动检测）"; enabled: !root.tree-sitter-busy; }
                            Text { text: "Tree-sitter 配置文件"; color: Theme.text; }
                            LineEdit { text <=> root.tree-sitter-config; placeholder-text: "config.json 路径（留空使用默认配置）"; enabled: !root.tree-sitter-busy; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: "保存设置"; enabled: !root.tree-sitter-busy; clicked => { root.tree-sitter-save(); } }
                                Button { text: "检测"; enabled: !root.tree-sitter-busy; clicked => { root.tree-sitter-detect(); } }
                                Button { text: "扫描语言"; enabled: !root.tree-sitter-busy; clicked => { root.tree-sitter-languages(); } }
                                Button { text: "使用 Cargo 安装"; enabled: !root.tree-sitter-busy; clicked => { root.tree-sitter-install(); } }
                            }
                            Text { text: root.tree-sitter-message; color: Theme.muted; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Tab {
                        title: "源码字体";
                        VerticalLayout {
                            padding-top: 16px; spacing: 12px;
                            Text { text: "源码字体"; color: Theme.text; font-size: 16px; }
                            Text { text: "输入本机已安装的字体名称；推荐使用等宽字体。"; color: Theme.muted; wrap: word-wrap; }
                            LineEdit { text <=> root.source-font-draft; placeholder-text: "字体名称，例如 monospace、Menlo、Consolas"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "字号（8–48）"; color: Theme.text; vertical-alignment: center; }
                                SpinBox { minimum: 8; maximum: 48; value <=> root.source-font-size-draft; }
                                Button { text: "应用并保存"; clicked => { root.apply-source-font(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text { text: "也可在源码区域按住 Ctrl 滚轮缩放；滚轮缩放会自动保存。"; color: Theme.muted; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Tab {
                        title: "自定义背景";
                        VerticalLayout {
                            padding-top: 16px; spacing: 12px;
                            Text { text: "全局背景"; color: Theme.text; font-size: 16px; }
                            Text { text: "选择 PNG、JPEG、WebP 或 BMP 图片；设置应用后会自动保存。"; color: Theme.muted; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { text <=> root.background-path-draft; placeholder-text: "背景图片路径"; horizontal-stretch: 1; enabled: !root.background-loading; }
                                Button { text: "浏览…"; enabled: !root.background-loading && !root.file-dialog-open; clicked => { root.browse-background(); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "图片不透明度（0–100%）"; color: Theme.text; vertical-alignment: center; }
                                SpinBox { minimum: 0; maximum: 100; value <=> root.background-opacity-draft; enabled: !root.background-loading; }
                                Text { text: "高斯模糊（0–30）"; color: Theme.text; vertical-alignment: center; }
                                SpinBox { minimum: 0; maximum: 30; value <=> root.background-blur-draft; enabled: !root.background-loading; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: root.background-loading ? "处理中…" : "应用并保存"; enabled: !root.background-loading && !root.file-dialog-open; clicked => { root.apply-background(); } }
                                Button { text: "恢复默认背景"; enabled: !root.file-dialog-open; clicked => { root.clear-background(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text { text: "效果预览"; color: Theme.text; font-weight: 600; }
                            Rectangle {
                                min-height: 140px; vertical-stretch: 1;
                                background: Theme.background; border-radius: 10px; clip: true;
                                if root.background-preview-ready: Image {
                                    width: parent.width; height: parent.height;
                                    source: root.background-preview-image;
                                    image-fit: cover;
                                    opacity: root.background-opacity-draft * 0.01;
                                }
                                if root.background-preview-ready: Rectangle {
                                    x: 10px; y: 10px; width: parent.width * 0.23; height: parent.height - 20px;
                                    background: root.background-opacity-draft > 0 ? #191c2980 : Theme.sidebar;
                                    border-radius: 6px;
                                    Text { x: 10px; y: 10px; text: "文件树\n\n▾ 源文件\n  main.c"; color: Theme.muted; font-size: 11px; }
                                }
                                if root.background-preview-ready: Text {
                                    x: parent.width * 0.28; y: 20px;
                                    text: "源码 / 波形\n\n背景效果预览"; color: Theme.text; font-size: 12px;
                                }
                                if !root.background-preview-ready: Text {
                                    text: root.background-preview-message; color: Theme.muted;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.project-dialog-open: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #000a;
        TouchArea { }
        Rectangle {
            width: 700px; height: 460px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.sidebar; border-radius: 20px;
            VerticalLayout {
                padding: 28px; spacing: 16px;
                Text { text: "打开项目"; color: Theme.text; font-size: 22px; font-weight: 700; }
                Text { text: "新建项目，或从历史记录中继续。"; color: Theme.muted; }
                Text { text: "历史项目"; color: Theme.text; font-weight: 600; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        if root.project-history.length == 0: Text { text: "暂无历史项目"; color: Theme.muted; }
                        for path in root.project-history: HorizontalLayout {
                            spacing: 8px;
                            Text { text: path; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            Button { text: "打开"; enabled: !root.busy && !root.file-dialog-open; clicked => { root.open-project(path); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "新建项目"; enabled: !root.busy && !root.file-dialog-open; clicked => { root.new-project(); } }
                    Button { text: "浏览项目文件…"; enabled: !root.busy && !root.file-dialog-open; clicked => { root.browse-project(); } }
                }
                Text { text: root.status; color: Theme.muted; wrap: word-wrap; }
            }
        }
    }
    firmware-update-overlay := Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        property <float> reveal: root.firmware-update-open ? 1 : 0;
        animate reveal { duration: 240ms; easing: ease-out; }
        visible: root.firmware-update-open || self.reveal > 0;
        background: #000a;
        TouchArea { }
        Rectangle {
            width: min(560px, root.width - 48px); height: 280px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1 - firmware-update-overlay.reveal) * 24px;
            background: Theme.sidebar; border-radius: 20px;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    Text { text: "固件文件已更新"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-stretch: 1; }
                    Button { text: "关闭"; clicked => { root.respond-firmware-update(false); } }
                }
                Text { text: "检测到当前固件发生变化，是否下载新的固件？"; color: Theme.text; wrap: word-wrap; }
                Rectangle {
                    background: Theme.panel; border-radius: 8px;
                    vertical-stretch: 1;
                    ScrollView {
                        x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px;
                        Text { text: root.firmware-update-path; color: Theme.muted; wrap: word-wrap; }
                    }
                }
                Text { text: "下载完成后将自动复位目标。"; color: Theme.muted; font-size: 12px; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "暂不下载"; clicked => { root.respond-firmware-update(false); } }
                    Button { text: "下载新固件"; clicked => { root.respond-firmware-update(true); } }
                }
            }
        }
    }
    if root.firmware-parsing: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #000a;
        TouchArea { }
        Rectangle {
            width: min(480px, root.width - 48px); height: 230px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.sidebar; border-radius: 16px;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                Text { text: "正在解析编译产物"; color: Theme.text; font-size: 18px; font-weight: 700; }
                Text { text: root.firmware-parse-path; color: Theme.muted; font-size: 11px; overflow: elide; }
                Text { text: root.firmware-parse-stage; color: Theme.text; font-size: 13px; }
                Rectangle {
                    height: 8px; background: Theme.border; border-radius: 4px; clip: true;
                    Rectangle {
                        x: 0px; y: 0px;
                        width: parent.width * root.firmware-parse-progress;
                        height: parent.height; background: Theme.accent; border-radius: 4px;
                    }
                }
                HorizontalLayout {
                    Text { text: root.firmware-parse-details; color: Theme.muted; font-size: 12px; horizontal-stretch: 1; }
                    Text { text: round(root.firmware-parse-progress * 100) + "%"; color: Theme.accent; font-size: 12px; }
                }
            }
        }
    }
}


export component SystemLogWindow inherits Window {
    title: "系统日志";
    preferred-width: 800px;
    preferred-height: 500px;
    min-width: 500px;
    min-height: 300px;
    background: Theme.background;
    in property <image> background-image;
    in property <bool> background-active;
    in property <int> background-opacity;
    if root.background-active: Image { width: root.width; height: root.height; source: root.background-image; image-fit: cover; opacity: root.background-opacity * 0.01; }
    in property <string> events;
    in property <string> debug-output;
    callback clear-events();
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        HorizontalLayout {
            Text { text: "系统日志"; color: Theme.text; font-size: 18px; font-weight: 700; horizontal-stretch: 1; }
            Button { text: "清空应用事件"; clicked => { root.clear-events(); } }
        }
        Text { text: "应用事件按程序运行时间记录，最新事件在最上方；调试输出显示当前 GDB 会话的最近日志。"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
        TabWidget {
            vertical-stretch: 1;
            Tab { title: "应用事件"; VerticalLayout { TextEdit { text: root.events; read-only: true; wrap: no-wrap; font-family: "monospace"; } } }
            Tab { title: "调试输出"; VerticalLayout { TextEdit { text: root.debug-output; read-only: true; wrap: no-wrap; font-family: "monospace"; } } }
        }
    }
}

export component BreakpointWindow inherits Window {
    title: "断点记录";
    preferred-width: 700px;
    preferred-height: 420px;
    background: Theme.background;
    in property <image> background-image;
    in property <bool> background-active;
    in property <int> background-opacity;
    if root.background-active: Image { width: root.width; height: root.height; source: root.background-image; image-fit: cover; opacity: root.background-opacity * 0.01; }
    in property <[BreakpointRow]> breakpoints;
    in property <bool> can-edit;
    in property <bool> can-edit-pending;
    callback set-enabled(string, bool);
    callback remove(string);
    VerticalLayout {
        padding: 16px; spacing: 10px;
        Text { text: "断点记录"; color: Theme.text; font-size: 18px; font-weight: 700; }
        Text { text: root.breakpoints.length == 0 ? "当前没有断点" : "待设置断点可提前管理；运行中修改断点会短暂暂停目标后恢复"; color: Theme.muted; }
        ListView {
            vertical-stretch: 1;
            for bp in root.breakpoints: HorizontalLayout {
                height: 42px; spacing: 8px;
                Text { text: bp.label; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: bp.enabled ? "禁用" : "启用"; enabled: root.can-edit || (bp.pending && root.can-edit-pending); clicked => { root.set-enabled(bp.id, !bp.enabled); } }
                Button { text: "删除"; enabled: root.can-edit || (bp.pending && root.can-edit-pending); clicked => { root.remove(bp.id); } }
            }
        }
    }
}

export component WaveformWindow inherits Window {
    title: "实时波形";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 600px;
    min-height: 480px;
    background: Theme.background;
    in property <image> background-image;
    in property <bool> background-active;
    in property <int> background-opacity;
    if root.background-active: Image { width: root.width; height: root.height; source: root.background-image; image-fit: cover; opacity: root.background-opacity * 0.01; }
    in property <[WaveformRow]> channels;
    in property <[string]> charts;
    in property <int> selected-chart;
    in property <[WaveformPath]> paths;
    in property <[string]> axis-channels;
    in property <int> axis-index;
    in property <[string]> y-ticks;
    in property <[string]> time-ticks;
    in property <string> zoom-label;
    callback zoom(bool, bool, bool);
    callback select-axis(int);
    in property <bool> active;
    in property <string> status;
    in property <string> statistics;
    in-out property <string> endpoint;
    in property <string> source-label;
    in property <bool> use-session;
    in property <bool> session-ready;
    in-out property <bool> detached: true;
    callback toggle-detached(bool);
    callback add-chart();
    callback select-chart(int);
    callback move-channel(int, int, int);
    callback export-csv();
    callback clear-history();
    callback start();
    callback stop();
    callback remove(int, int);
    callback endpoint-edited(string);
    changed endpoint => { root.endpoint-edited(root.endpoint); }
    WaveformsPage {
        custom-background: root.background-active && root.background-opacity > 0;
        padding: 12px;
        detached <=> root.detached;
        channels: root.channels;
        charts: root.charts;
        selected-chart: root.selected-chart;
        paths: root.paths;
        axis-channels: root.axis-channels;
        axis-index: root.axis-index;
        y-ticks: root.y-ticks;
        time-ticks: root.time-ticks;
        zoom-label: root.zoom-label;
        zoom(up, control, alt) => { root.zoom(up, control, alt); }
        select-axis(index) => { root.select-axis(index); }
        active: root.active;
        status: root.status;
        statistics: root.statistics;
        endpoint <=> root.endpoint;
        source-label: root.source-label;
        use-session: root.use-session;
        session-ready: root.session-ready;
        toggle-detached(value) => { root.toggle-detached(value); }
        add-chart => { root.add-chart(); }
        select-chart(index) => { root.select-chart(index); }
        move-channel(watch, node, chart) => { root.move-channel(watch, node, chart); }
        export-csv => { root.export-csv(); }
        clear-history => { root.clear-history(); }
        start => { root.start(); }
        stop => { root.stop(); }
        remove(watch, node) => { root.remove(watch, node); }
    }
}

export component InstallProgressWindow inherits Window {
    title: root.window-title;
    in property <string> window-title: "安装工具链";
    in property <bool> can-cancel: true;
    width: 480px;
    height: 205px;
    background: Theme.background;
    in property <image> background-image;
    in property <bool> background-active;
    in property <int> background-opacity;
    if root.background-active: Image { width: root.width; height: root.height; source: root.background-image; image-fit: cover; opacity: root.background-opacity * 0.01; }
    in property <string> message;
    in property <string> stage;
    in property <string> details;
    in property <float> progress;
    in property <bool> determinate;
    in property <float> phase;
    in-out property <bool> cancelling: false;
    callback cancel();
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        Text { text: root.cancelling ? "正在取消并清理安装文件…" : root.message; color: Theme.text; wrap: word-wrap; }
        Text { text: root.stage; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        Rectangle {
            height: 6px;
            background: Theme.border;
            clip: true;
            Rectangle { x: root.determinate ? 0px : (parent.width + self.width) * root.phase - self.width; width: root.determinate ? parent.width * root.progress : parent.width / 3; height: parent.height; background: Theme.accent; }
        }
        Text { text: root.details; color: Theme.text; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            if root.can-cancel: Button { text: root.cancelling ? "正在取消…" : "取消"; enabled: !root.cancelling; clicked => { root.cancel(); } }
        }
    }
}

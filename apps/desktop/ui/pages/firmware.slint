import { Button, CheckBox, LineEdit, TextEdit, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct FirmwareTreeRow {
    label: string,
    type-name: string,
    depth: int,
    branch: bool,
    expanded: bool,
    variable: bool,
    can-plot: bool,
    source-path: string,
}

export component FirmwarePage inherits VerticalLayout {
    in property <bool> busy;
    in-out property <string> path;
    in property <string> title;
    in property <[FirmwareTreeRow]> tree;
    in property <length> tree-label-width;
    in property <length> tree-content-width;
    in property <string> details;
    in property <int> selected-node;
    in-out property <bool> functions-visible;
    in-out property <string> search-query;
    callback search(string);
    callback open();
    callback browse();
    callback select-node(int);
    callback select-file(int);
    callback open-source-file(string);
    callback add-variable(int);
    callback plot-variable(int);
    callback show-functions(bool);
    spacing: 10px;
    HorizontalLayout {
        Text { text: "文件树"; color: Theme.text; font-size: 15px; font-weight: 700; horizontal-stretch: 1; }
        Button { text: "浏览…"; enabled: !root.busy; clicked => { root.browse(); } }
        Button { text: "解析文件"; enabled: !root.busy; clicked => { root.open(); } }
    }
    LineEdit {
        text <=> root.path;
        placeholder-text: "ELF / AXF 等编译产物路径…";
        enabled: !root.busy;
        accepted => { root.open(); }
    }
    Text { text: root.title; color: Theme.muted; font-size: 12px; overflow: elide; }
    HorizontalLayout {
        spacing: 4px;
        LineEdit {
            text <=> root.search-query;
            placeholder-text: "搜索文件 / 函数名…";
            horizontal-stretch: 1;
            edited => { root.search(self.text); }
        }
        Button { text: "×"; enabled: root.search-query != ""; clicked => { root.search-query = ""; root.search(""); } }
    }
    CheckBox {
        text: "显示函数";
        checked <=> root.functions-visible;
        toggled => { root.show-functions(self.checked); }
    }
    Rectangle {
        min-height: 140px;
        vertical-stretch: 3;
        background: Theme.background;
        border-radius: 12px;
        clip: true;
        tree-view := ListView {
            content-width: max(self.visible-width, root.tree-content-width);
            horizontal-scrollbar-policy: as-needed;
            for row[index] in root.tree: Rectangle {
                height: 32px;
                width: tree-view.content-width;
                border-radius: 8px;
                background: index == root.selected-node ? Theme.selection : (area.has-hover ? Theme.panel : transparent);
                Text {
                    x: 8px + row.depth * 14px;
                    width: max(0px, root.tree-label-width - self.x);
                    height: parent.height;
                    vertical-alignment: center;
                    text: (row.branch ? (row.expanded ? "▾ " : "▸ ") : "  ") + row.label;
                    color: index == root.selected-node ? Theme.text : Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                }
                if row.type-name != "": Text {
                    x: root.tree-label-width;
                    width: max(0px, parent.width - self.x - 8px);
                    height: parent.height;
                    text: row.type-name;
                    color: Theme.accent;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                menu := ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "加入实时波形";
                            enabled: row.can-plot;
                            activated => { root.plot-variable(index); }
                        }
                        MenuItem {
                            title: "加入监视";
                            enabled: row.variable;
                            activated => { root.add-variable(index); }
                        }
                    }
                }
                area := TouchArea {
                    property <bool> middle-dragging: false;
                    property <length> drag-start-x;
                    property <length> drag-start-y;
                    property <length> drag-content-x;
                    property <length> drag-content-y;
                    clicked => { if row.source-path != "" { root.select-file(index); } else { root.select-node(index); } }
                    double-clicked => { if row.source-path != "" { root.open-source-file(row.source-path); } else if row.variable { root.add-variable(index); } }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            menu.show({ x: self.mouse-x, y: self.mouse-y });
                        }
                        if event.button == PointerEventButton.middle && event.kind == PointerEventKind.down {
                            self.middle-dragging = true;
                            self.drag-start-x = self.mouse-x + tree-view.content-x;
                            self.drag-start-y = self.mouse-y + parent.y + tree-view.content-y;
                            self.drag-content-x = tree-view.content-x;
                            self.drag-content-y = tree-view.content-y;
                        }
                        if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.up) || event.kind == PointerEventKind.cancel {
                            self.middle-dragging = false;
                        }
                    }
                    moved => {
                        if self.middle-dragging {
                            tree-view.content-x = min(0px, max(tree-view.visible-width - tree-view.content-width,
                                self.drag-content-x + self.mouse-x + tree-view.content-x - self.drag-start-x));
                            tree-view.content-y = min(0px, max(tree-view.visible-height - tree-view.content-height,
                                self.drag-content-y + self.mouse-y + parent.y + tree-view.content-y - self.drag-start-y));
                        }
                    }
                }
                if row.source-path != "" && row.branch: TouchArea {
                    x: 8px + row.depth * 14px; width: 18px; height: parent.height;
                    clicked => { root.select-node(index); }
                }
            }
        }
        if root.tree.length == 0: Text {
            text: root.search-query != "" ? "没有匹配的文件或函数" : "尚无文件条目\n\n解析编译产物以浏览\n源文件、函数与变量";
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle { height: 1px; background: Theme.border; }
    Text { text: "变量解析"; color: Theme.text; font-size: 15px; font-weight: 700; }
    TextEdit {
        text: root.details;
        read-only: true;
        font-family: "monospace";
        font-size: 12px;
        min-height: 160px;
        vertical-stretch: 2;
    }
}

import { Button, LineEdit, TextEdit, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct FirmwareTreeRow {
    label: string,
    depth: int,
    branch: bool,
    expanded: bool,
    variable: bool,
    can-plot: bool,
}

export component FirmwarePage inherits VerticalLayout {
    in property <bool> busy;
    in-out property <string> path;
    in property <string> title;
    in property <[FirmwareTreeRow]> tree;
    in property <string> details;
    in property <int> selected-node;
    in property <bool> can-add-variable;
    callback open();
    callback select-node(int);
    callback add-variable();
    callback plot-variable(int);
    spacing: 10px;
    HorizontalLayout {
        Text { text: "文件树"; color: Theme.text; font-size: 15px; font-weight: 700; horizontal-stretch: 1; }
        Button { text: "解析文件"; enabled: !root.busy; clicked => { root.open(); } }
    }
    LineEdit {
        text <=> root.path;
        placeholder-text: "ELF / AXF 等编译产物路径…";
        enabled: !root.busy;
        accepted => { root.open(); }
    }
    Text { text: root.title; color: Theme.muted; font-size: 12px; overflow: elide; }
    Rectangle {
        min-height: 140px;
        vertical-stretch: 3;
        background: Theme.background;
        border-color: Theme.border;
        border-width: 1px;
        ListView {
            for row[index] in root.tree: Rectangle {
                height: 30px;
                background: index == root.selected-node ? Theme.selection : (area.has-hover ? Theme.panel : transparent);
                Text {
                    x: 8px + row.depth * 14px;
                    width: max(0px, parent.width - self.x - 8px);
                    height: parent.height;
                    vertical-alignment: center;
                    text: (row.branch ? (row.expanded ? "▾ " : "▸ ") : "  ") + row.label;
                    color: index == root.selected-node ? Theme.text : Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                }
                menu := ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "加入实时波形";
                            enabled: row.can-plot && !root.busy;
                            activated => { root.plot-variable(index); }
                        }
                        MenuItem {
                            title: "加入监视";
                            enabled: row.variable && !root.busy;
                            activated => { root.select-node(index); root.add-variable(); }
                        }
                    }
                }
                area := TouchArea {
                    clicked => { root.select-node(index); }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            menu.show({ x: self.mouse-x, y: self.mouse-y });
                        }
                    }
                }
            }
        }
        if root.tree.length == 0: Text {
            text: "尚无文件条目\n\n解析编译产物以浏览\n源文件、函数与变量";
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle { height: 1px; background: Theme.border; }
    HorizontalLayout {
        Text { text: "变量解析"; color: Theme.text; font-size: 15px; font-weight: 700; horizontal-stretch: 1; }
        Button {
            text: "+ 监视";
            enabled: root.can-add-variable && !root.busy;
            clicked => { root.add-variable(); }
        }
    }
    TextEdit {
        text: root.details;
        read-only: true;
        font-family: "monospace";
        font-size: 12px;
        min-height: 160px;
        vertical-stretch: 2;
    }
}

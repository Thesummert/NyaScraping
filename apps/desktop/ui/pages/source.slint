import { Button, LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct SourceTab {
    name: string,
    path: string,
}
export struct SourceBreakpoint { line: int, id: string, enabled: bool, pending: bool }

export component SourcePage inherits VerticalLayout {
    in property <bool> busy;
    in-out property <string> path;
    in property <string> source-title;
    in property <string> metadata;
    in property <string> source-text;
    in property <[SourceTab]> tabs;
    in property <int> selected-tab;
    in property <int> line-count;
    in property <bool> halted;
    in property <[SourceBreakpoint]> breakpoints;
    in property <[bool]> executable-lines;
    in property <string> line-hint;
    in property <bool> firmware-matches;
    callback toggle-breakpoint(int);
    callback select-tab(int);
    callback close-tab(int);
    callback open();
    callback browse();
    spacing: 12px;
    HorizontalLayout {
        spacing: 8px;
        LineEdit { text <=> root.path; placeholder-text: "输入源码文件路径…"; enabled: !root.busy; horizontal-stretch: 1; accepted => { root.open(); } }
        Button { text: "浏览…"; enabled: !root.busy; clicked => { root.browse(); } }
        Button { text: "打开源码"; enabled: !root.busy; clicked => { root.open(); } }
    }
    if root.tabs.length > 0: ScrollView {
        height: 36px;
        horizontal-scrollbar-policy: as-needed;
        vertical-scrollbar-policy: always-off;
        content-width: max(self.visible-width, root.tabs.length * 164px);
        HorizontalLayout {
            spacing: 4px;
            for tab[index] in root.tabs: Rectangle {
                width: 160px; height: 30px;
                background: index == root.selected-tab ? Theme.selection : Theme.panel;
                border-radius: 6px;
                TouchArea { clicked => { root.select-tab(index); } }
                HorizontalLayout {
                    padding-left: 8px; padding-right: 4px;
                    Text { text: tab.name; color: Theme.text; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    Button { text: "×"; clicked => { root.close-tab(index); } }
                }
            }
        }
    }
    Text { text: root.source-title; color: Theme.text; overflow: elide; }
    Text { text: root.metadata; color: Theme.muted; }
    if root.selected-tab >= 0: Text {
        text: root.firmware-matches ? root.line-hint : "请先解析当前编译产物，查看可设置断点的行";
        color: Theme.muted; font-size: 11px; wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 0px;
        vertical-stretch: 1;
        gutter := Rectangle {
            width: 62px;
            background: Theme.sidebar;
            clip: true;
            // Match the TextEdit's font metrics and its Fluent 12px scroll padding.
            property <length> line-height: metric.preferred-height;
            property <int> first-line: floor(max(0, -editor.content-y / self.line-height));
            metric := Text { text: "M"; font-family: "monospace"; font-size: 14px; visible: false; }
            for n[index] in (ceil(gutter.height / gutter.line-height) + 2): Rectangle {
                property <int> line: gutter.first-line + index + 1;
                y: 12px + editor.content-y + (self.line - 1) * gutter.line-height;
                width: parent.width; height: gutter.line-height;
                visible: root.selected-tab >= 0 && self.line <= root.line-count;
                background: hit.has-hover && hit.enabled ? Theme.selection : transparent;
                if root.firmware-matches && gutter.first-line + index < root.executable-lines.length && root.executable-lines[gutter.first-line + index]: Rectangle {
                    x: 7px; y: (parent.height - 6px) / 2;
                    width: 6px; height: 6px; border-radius: 3px; background: Theme.accent;
                }
                Text { text: parent.line; color: Theme.muted; font-family: "monospace"; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; x: 18px; width: parent.width - 22px; height: parent.height; }
                hit := TouchArea { enabled: !root.busy; clicked => { root.toggle-breakpoint(parent.line); } }
            }
            for bp in root.breakpoints: Rectangle {
                x: 5px; y: 12px + editor.content-y + (bp.line - 1) * gutter.line-height + (gutter.line-height - 10px) / 2;
                width: 10px; height: 10px; border-radius: 5px;
                background: bp.enabled ? (bp.pending ? #e9ab56 : #ef5a66) : transparent;
                border-width: 1px; border-color: bp.enabled ? (bp.pending ? #e9ab56 : #ef5a66) : Theme.muted;
                TouchArea { enabled: !root.busy; clicked => { root.toggle-breakpoint(bp.line); } }
            }
        }
        editor := TextEdit { text: root.source-text; read-only: true; wrap: no-wrap; font-family: "monospace"; font-size: 14px; horizontal-stretch: 1; }
    }
}

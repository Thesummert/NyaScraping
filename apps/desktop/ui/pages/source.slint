import { Button, CheckBox, LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct SourceTab {
    name: string,
    path: string,
}
export struct SourceBreakpoint { line: int, id: string, enabled: bool, pending: bool }
export struct HighlightSpan { text: string, color: color }
export struct HighlightLine { spans: [HighlightSpan] }

export component SourcePage inherits VerticalLayout {
    in property <bool> busy;
    in property <bool> custom-background;
    in-out property <string> path;
    in property <string> source-title;
    in property <string> metadata;
    in property <string> source-text;
    in property <string> font-family: "monospace";
    in property <int> font-size: 14;
    out property <length> editor-x: editor-area.absolute-position.x + 62px;
    out property <length> editor-y: editor-area.absolute-position.y;
    out property <length> editor-width: max(0px, editor-area.width - 62px);
    out property <length> editor-height: editor-area.height;
    in property <[HighlightLine]> highlight-lines;
    in-out property <bool> highlight-enabled;
    in property <int> highlight-width;
    in property <[SourceTab]> tabs;
    in property <int> selected-tab;
    in property <int> line-count;
    in property <bool> halted;
    in property <int> execution-line;
    public function reveal-execution-line() { navigation-timer.running = true; }
    navigation-timer := Timer {
        interval: 0ms;
        running: false;
        triggered => { self.running = false; root.scroll-to-execution-line(); }
    }
    function scroll-to-execution-line() {
        if root.execution-line > 0 {
            editor.content-y = -max(0px, min(editor.content-height - editor.visible-height, (root.execution-line - 1) * gutter.line-height - editor.visible-height / 3));
            colored.content-y = -max(0px, min(colored.content-height - colored.visible-height, (root.execution-line - 1) * gutter.line-height - colored.visible-height / 3));
        }
    }
    changed highlight-lines => { root.reveal-execution-line(); }
    in property <[SourceBreakpoint]> breakpoints;
    in property <[bool]> executable-lines;
    in property <string> line-hint;
    in property <bool> firmware-matches;
    callback toggle-breakpoint(int);
    callback select-tab(int);
    callback close-tab(int);
    callback open();
    callback browse();
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        LineEdit { text <=> root.path; placeholder-text: "输入源码文件路径…"; enabled: !root.busy; horizontal-stretch: 1; accepted => { root.open(); } }
        Button { text: "浏览…"; enabled: !root.busy; clicked => { root.browse(); } }
        Button { text: "打开源码"; enabled: !root.busy; clicked => { root.open(); } }
        CheckBox { text: "语法高亮"; checked <=> root.highlight-enabled; }
    }
    if root.tabs.length > 0: ScrollView {
        height: 36px;
        horizontal-scrollbar-policy: as-needed;
        vertical-scrollbar-policy: always-off;
        content-width: max(self.visible-width, root.tabs.length * 164px);
        HorizontalLayout {
            spacing: 4px;
            for tab[index] in root.tabs: Rectangle {
                width: 160px; height: 30px;
                background: index == root.selected-tab ? Theme.selection : Theme.panel;
                animate background { duration: 140ms; }
                border-radius: 6px;
                TouchArea { clicked => { root.select-tab(index); } }
                HorizontalLayout {
                    padding-left: 8px; padding-right: 4px;
                    Text { text: tab.name; color: Theme.text; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    Button { text: "×"; clicked => { root.close-tab(index); } }
                }
            }
        }
    }
    Text { text: root.source-title; color: Theme.text; overflow: elide; }
    Text { text: root.metadata; color: Theme.muted; }
    if root.selected-tab >= 0: Text {
        text: root.firmware-matches ? root.line-hint : "请先解析当前编译产物，查看可设置断点的行";
        color: Theme.muted; font-size: 11px; wrap: word-wrap;
    }
    editor-area := HorizontalLayout {
        spacing: 0px;
        vertical-stretch: 1;
        gutter := Rectangle {
            width: 62px;
            background: root.custom-background ? #191c2980 : Theme.sidebar;
            clip: true;
            // Measure the multiline input: a rounded single-line Text height drifts
            // away from TextEdit after scrolling, so gutter clicks hit wrong lines.
            property <length> line-height: metric.preferred-height / max(1, root.line-count);
            property <length> scroll-y: root.highlight-lines.length > 0 ? colored.content-y : editor.content-y;
            property <int> first-line: floor(max(0, -self.scroll-y / self.line-height));
            metric := TextInput { text: root.source-text; single-line: false; wrap: no-wrap; read-only: true; font-family: root.font-family; font-size: root.font-size * 1px; visible: false; }
            for n[index] in (ceil(gutter.height / gutter.line-height) + 2): Rectangle {
                property <int> line: gutter.first-line + index + 1;
                y: 12px + gutter.scroll-y + (self.line - 1) * gutter.line-height;
                width: parent.width; height: gutter.line-height;
                visible: root.selected-tab >= 0 && self.line <= root.line-count;
                background: self.line == root.execution-line ? #080a11 : (hit.has-hover && hit.enabled ? Theme.selection : transparent);
                animate background { duration: 140ms; }
                if root.firmware-matches && gutter.first-line + index < root.executable-lines.length && root.executable-lines[gutter.first-line + index]: Rectangle {
                    x: 7px; y: (parent.height - 6px) / 2;
                    width: 6px; height: 6px; border-radius: 3px; background: Theme.accent;
                }
                Text { text: parent.line; color: Theme.muted; font-family: "monospace"; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; x: 18px; width: parent.width - 22px; height: parent.height; }
                hit := TouchArea { enabled: !root.busy; clicked => { root.toggle-breakpoint(parent.line); } }
            }
            for bp in root.breakpoints: Rectangle {
                x: 5px; y: 12px + gutter.scroll-y + (bp.line - 1) * gutter.line-height + (gutter.line-height - 10px) / 2;
                width: 10px; height: 10px; border-radius: 5px;
                background: bp.enabled ? (bp.pending ? #e9ab56 : #ef5a66) : transparent;
                border-width: 1px; border-color: bp.enabled ? (bp.pending ? #e9ab56 : #ef5a66) : Theme.muted;
                TouchArea { enabled: !root.busy; clicked => { root.toggle-breakpoint(bp.line); } }
            }
        }
        plain := Rectangle {
            clip: true;
            horizontal-stretch: root.highlight-lines.length == 0 ? 1 : 0;
            min-width: 0px; max-width: root.highlight-lines.length == 0 ? 100000px : 0px;
            editor := TextEdit { width: parent.width; height: parent.height; visible: root.highlight-lines.length == 0; text: root.source-text; read-only: true; wrap: no-wrap; font-family: root.font-family; font-size: root.font-size * 1px; }
            Rectangle {
                visible: root.execution-line > 0 && root.highlight-lines.length == 0;
                x: 12px; y: 12px + editor.content-y + (root.execution-line - 1) * gutter.line-height;
                width: max(0px, editor.visible-width - 24px); height: gutter.line-height;
                background: #00000055;
                Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: Theme.accent; }
            }
        }
        colored := ScrollView {
            visible: root.highlight-lines.length > 0;
            horizontal-stretch: root.highlight-lines.length > 0 ? 1 : 0;
            min-width: 0px; max-width: root.highlight-lines.length > 0 ? 100000px : 0px;
            content-height: root.highlight-lines.length * gutter.line-height + 24px;
            content-width: max(self.visible-width, root.highlight-width * root.font-size * 2px + 24px);
            for n[index] in (ceil(self.visible-height / gutter.line-height) + 2): Rectangle {
                property <int> line-index: gutter.first-line + index;
                x: 12px; y: 12px + self.line-index * gutter.line-height;
                width: colored.content-width - 24px; height: gutter.line-height;
                visible: self.line-index < root.highlight-lines.length;
                background: self.line-index + 1 == root.execution-line ? #080a11 : transparent;
                if self.line-index + 1 == root.execution-line: Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: Theme.accent; }
                HorizontalLayout {
                    spacing: 0px;
                    for span in root.highlight-lines[parent.line-index].spans: Text {
                        text: span.text; color: span.color; font-family: root.font-family; font-size: root.font-size * 1px;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

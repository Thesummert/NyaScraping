import { Button, CheckBox, ComboBox, LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct WatchRow {
    expression: string,
    type-name: string,
    value: string,
    error: string,
    scope: string,
    entry-index: int,
    node-index: int,
    depth: int,
    branch: bool,
    expanded: bool,
    waveform: bool,
    can-plot: bool,
    plot-hint: string,
    subtree-end: int,
}

export component VariablesPage inherits VerticalLayout {
    in property <[WatchRow]> watches;
    in property <length> name-width: 72px;
    in property <length> type-width: 76px;
    in property <length> value-width: 68px;
    in property <bool> can-write;
    in property <bool> acquisition-active;
    in-out property <string> memory-endpoint;
    in property <string> source-label;
    in property <bool> use-session;
    in property <bool> session-ready;
    in property <int> revision;
    in-out property <bool> live-enabled;
    in-out property <int> live-interval-index: 5;
    in-out property <string> live-custom-hz: "10";
    in property <string> frequency-error;
    in property <string> sample-status;
    callback live-refresh();
    private property <int> edit-revision: -1;
    private property <int> edit-entry: -1;
    private property <int> edit-node: -1;
    private property <string> edit-name;
    callback write(int, int, string);
    callback add(string);
    callback remove(int);
    callback toggle-waveform(int, int);
    callback toggle(int, int);
    private property <int> animation-start: -1;
    private property <int> animation-end: -1;
    private property <int> closing-entry: -1;
    private property <int> closing-node: -1;
    private property <int> closing-revision: -1;
    private property <bool> animation-visible: true;
    private property <bool> closing: false;
    private property <bool> opening-wait: false;
    function toggle-branch(index: int) {
        if list-animation.running { return; }
        if root.watches[index].expanded {
            root.animation-start = index;
            root.animation-end = root.watches[index].subtree-end;
            root.closing-entry = root.watches[index].entry-index;
            root.closing-node = root.watches[index].node-index;
            root.closing-revision = root.revision;
            root.closing = true;
            root.animation-visible = false;
            list-animation.interval = 320ms;
            list-animation.start();
        } else {
            root.animation-start = index;
            root.animation-end = index + 1;
            root.animation-visible = false;
            root.toggle(root.watches[index].entry-index, root.watches[index].node-index);
            root.animation-end = root.watches[index].subtree-end;
            root.closing = false;
            root.opening-wait = true;
            list-animation.interval = 20ms;
            list-animation.start();
        }
    }
    list-animation := Timer {
        interval: 20ms;
        running: false;
        triggered => {
            self.stop();
            if root.opening-wait {
                root.opening-wait = false;
                root.animation-visible = true;
                self.interval = 320ms;
                self.start();
            } else {
                if root.closing && root.revision == root.closing-revision {
                    root.toggle(root.closing-entry, root.closing-node);
                }
                root.animation-start = -1;
                root.animation-end = -1;
                root.closing = false;
                root.animation-visible = true;
            }
        }
    }
    spacing: 8px;
    Text { text: "变量监视"; color: Theme.text; font-size: 15px; font-weight: 700; }
    HorizontalLayout {
        spacing: 6px;
        Text { text: root.source-label; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
        if !root.use-session: LineEdit { text <=> root.memory-endpoint; placeholder-text: "127.0.0.1:6666"; enabled: !root.acquisition-active; horizontal-stretch: 1; }
    }
    if root.use-session && !root.session-ready: Text { text: "请先在调试页连接当前后端"; color: Theme.muted; font-size: 11px; }
    HorizontalLayout {
        spacing: 6px;
        CheckBox { text: "实时刷新"; enabled: !root.use-session || root.session-ready; checked <=> root.live-enabled; toggled => { root.live-refresh(); } }
        ComboBox {
            model: ["100 Hz · 10 ms", "50 Hz · 20 ms", "20 Hz · 50 ms", "10 Hz · 100 ms", "5 Hz · 200 ms", "2 Hz · 500 ms", "1 Hz · 1 s", "0.5 Hz · 2 s", "0.2 Hz · 5 s", "0.1 Hz · 10 s", "自定义…"];
            current-index <=> root.live-interval-index;
            selected => { root.live-refresh(); }
        }
    }
    if root.live-interval-index == 10: HorizontalLayout {
        spacing: 6px;
        LineEdit {
            text <=> root.live-custom-hz;
            placeholder-text: "0.1–1000 Hz";
            horizontal-stretch: 1;
            accepted => { root.live-refresh(); }
        }
        Text { text: "Hz"; color: Theme.muted; vertical-alignment: center; }
        Button { text: "应用"; clicked => { root.live-refresh(); } }
    }
    if root.frequency-error != "": Text {
        text: root.frequency-error;
        color: #f08a80;
        font-size: 11px;
        wrap: word-wrap;
    }
    Text { text: root.sample-status; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 6px;
        expression := LineEdit {
            placeholder-text: "变量名 / 表达式…";
            horizontal-stretch: 1;
            accepted => { root.add(self.text); self.text = ""; }
        }
        Button {
            text: "+";
            enabled: expression.text != "";
            clicked => { root.add(expression.text); expression.text = ""; }
        }
    }
    Rectangle {
        height: 20px;
        clip: true;
        background: transparent;
        HorizontalLayout {
            x: watch-view.content-x;
            width: watch-view.content-width;
            spacing: 6px;
            Text { text: "名称"; color: Theme.muted; min-width: root.name-width; horizontal-stretch: 1; }
            Text { text: "类型"; color: Theme.muted; width: root.type-width; }
            Text { text: "值"; color: Theme.muted; width: root.value-width; }
            Text { text: "波形"; color: Theme.muted; width: 40px; }
            Rectangle { width: 24px; background: transparent; }
            Rectangle { width: 28px; background: transparent; }
        }
    }
    Rectangle { height: 1px; background: Theme.border; }
    Rectangle {
        vertical-stretch: 1;
        background: transparent;
        clip: true;
        watch-view := ListView {
            content-width: max(self.visible-width, root.name-width + root.type-width + root.value-width + 122px);
            horizontal-scrollbar-policy: as-needed;
            for watch[index] in root.watches: Rectangle {
                width: watch-view.content-width;
                height: index > root.animation-start && index < root.animation-end && !root.animation-visible ? 1px : (watch.error == "" ? 32px : 50px);
                animate height {
                    duration: max(1ms, 280ms / max(1, root.animation-end - root.animation-start - 1));
                    delay: 280ms * max(0, root.closing ? root.animation-end - index - 1 : index - root.animation-start - 1) / max(1, root.animation-end - root.animation-start - 1);
                    easing: linear;
                }
                clip: true;
                background: area.has-hover ? Theme.panel : transparent;
                animate background { duration: 140ms; }
                border-radius: 8px;
                area := TouchArea {
                    property <bool> middle-dragging: false;
                    property <length> drag-start-x;
                    property <length> drag-start-y;
                    property <length> drag-content-x;
                    property <length> drag-content-y;
                    clicked => {
                        if watch.branch { root.toggle-branch(index); }
                    }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.middle && event.kind == PointerEventKind.down {
                            self.middle-dragging = true;
                            self.drag-start-x = self.mouse-x + watch-view.content-x;
                            self.drag-start-y = self.mouse-y + parent.y + watch-view.content-y;
                            self.drag-content-x = watch-view.content-x;
                            self.drag-content-y = watch-view.content-y;
                        }
                        if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.up) || event.kind == PointerEventKind.cancel {
                            self.middle-dragging = false;
                        }
                    }
                    moved => {
                        if self.middle-dragging {
                            watch-view.content-x = min(0px, max(watch-view.visible-width - watch-view.content-width,
                                self.drag-content-x + self.mouse-x + watch-view.content-x - self.drag-start-x));
                            watch-view.content-y = min(0px, max(watch-view.visible-height - watch-view.content-height,
                                self.drag-content-y + self.mouse-y + parent.y + watch-view.content-y - self.drag-start-y));
                        }
                    }
                }
                if watch.error != "": Text { y: 32px; height: 18px; width: parent.width; text: watch.error; color: #f08a80; font-size: 10px; overflow: elide; }

                HorizontalLayout {
                    height: 32px;
                    spacing: 6px;
                    padding-left: watch.depth * 12px;
                    Text {
                        text: (watch.branch ? (watch.expanded ? "▾ " : "▸ ") : "  ") + watch.expression;
                        color: Theme.text;
                        font-family: "monospace";
                        font-size: 12px;
                        overflow: elide;
                        min-width: max(0px, root.name-width - watch.depth * 12px);
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text { text: watch.type-name; color: Theme.accent; font-size: 12px; width: root.type-width; overflow: elide; vertical-alignment: center; }
                    Text { text: watch.value; color: watch.error != "" ? #f08a80 : Theme.text; font-size: 12px; width: root.value-width; overflow: elide; vertical-alignment: center; }
                    Rectangle {
                        width: 40px;
                        Image {
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: watch.waveform ? @image-url("../assets/eye.svg") : @image-url("../assets/eye-off.svg");
                            opacity: !watch.can-plot ? 0.35 : (eye-area.has-hover ? 0.75 : 1);
                            animate opacity { duration: 140ms; }
                        }
                        eye-area := TouchArea {
                            enabled: watch.can-plot;
                            clicked => { root.toggle-waveform(watch.entry-index, watch.node-index); }
                        }
                    }
                    Button {
                        width: 24px;
                        text: "✎";
                        enabled: root.can-write && !watch.branch;
                        clicked => {
                            root.edit-revision = root.revision;
                            root.edit-entry = watch.entry-index;
                            root.edit-node = watch.node-index;
                            root.edit-name = watch.expression;
                            new-value.text = "";
                            new-value.focus();
                        }
                    }
                    Rectangle {
                        width: 28px;
                        Text { text: watch.depth == 0 ? "×" : ""; color: remove-area.has-hover ? Theme.accent : Theme.muted; animate color { duration: 140ms; } horizontal-alignment: center; vertical-alignment: center; }
                        remove-area := TouchArea {
                            enabled: watch.depth == 0;
                            clicked => { root.edit-entry = -1; root.remove(watch.entry-index); }
                        }
                    }
                }
            }
        }
        if root.watches.length == 0: Text {
            text: "双击左侧变量即可添加监视";
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if (root.edit-entry >= 0 && root.edit-revision == root.revision): Text { text: "修改：" + root.edit-name; color: Theme.accent; overflow: elide; }
    HorizontalLayout {
        spacing: 6px;
        new-value := LineEdit {
            placeholder-text: "新值，如 1.5 / 0x10";
            enabled: root.can-write && (root.edit-entry >= 0 && root.edit-revision == root.revision);
            horizontal-stretch: 1;
            accepted => {
                if root.can-write && (root.edit-entry >= 0 && root.edit-revision == root.revision) && self.text != "" {
                    root.write(root.edit-entry, root.edit-node, self.text);
                    root.edit-entry = -1;
                }
            }
        }
        Button {
            text: "写入";
            enabled: root.can-write && (root.edit-entry >= 0 && root.edit-revision == root.revision) && new-value.text != "";
            clicked => { root.write(root.edit-entry, root.edit-node, new-value.text); root.edit-entry = -1; }
        }
    }
    Text { text: "监视刷新与波形共用无暂停采集；局部变量需暂停求值，手动写入会短暂暂停"; wrap: word-wrap; color: Theme.muted; font-size: 11px; }
}

import { Button, LineEdit, ListView, Switch } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct WatchRow {
    expression: string,
    type-name: string,
    scope: string,
    waveform: bool,
    can-plot: bool,
    value: string,
    plot-hint: string,
}

export component VariablesPage inherits VerticalLayout {
    in property <[WatchRow]> watches;
    callback add(string);
    callback remove(int);
    callback toggle-waveform(int);
    spacing: 10px;
    HorizontalLayout {
        Text { text: "监视变量"; color: Theme.text; font-size: 15px; font-weight: 700; horizontal-stretch: 1; }
        Text { text: root.watches.length; color: Theme.accent; }
    }
    Text { text: "从左侧添加变量，或输入表达式"; color: Theme.muted; font-size: 12px; }
    HorizontalLayout {
        spacing: 6px;
        expression := LineEdit {
            placeholder-text: "变量名 / 表达式…";
            horizontal-stretch: 1;
            accepted => {
                root.add(self.text);
                self.text = "";
            }
        }
        Button {
            text: "+";
            enabled: expression.text != "";
            clicked => {
                root.add(expression.text);
                expression.text = "";
            }
        }
    }
    Rectangle { height: 1px; background: Theme.border; }
    Rectangle {
        vertical-stretch: 1;
        background: transparent;
        ListView {
            for watch[index] in root.watches: Rectangle {
                height: 158px;
                background: Theme.panel;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: watch.expression; color: Theme.text; font-family: "monospace"; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                        Button { text: "移除"; clicked => { root.remove(index); } }
                    }
                    Text { text: watch.type-name; color: Theme.accent; font-size: 12px; overflow: elide; }
                    Text { text: watch.scope; color: Theme.muted; font-size: 11px; overflow: elide; }
                    Text { text: "当前值：" + watch.value; color: Theme.muted; font-size: 12px; overflow: elide; }
                    HorizontalLayout {
                        Text { text: watch.plot-hint; color: Theme.muted; font-size: 10px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        Switch {
                            text: "波形";
                            checked: watch.waveform;
                            enabled: watch.can-plot;
                            toggled => { root.toggle-waveform(index); }
                        }
                    }
                }
            }
        }
        if root.watches.length == 0: Text {
            text: "尚未添加监视变量\n\n在文件树中选择变量\n点击「+ 监视」添加到此处";
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text { text: "打开小开关加入实时波形；固定地址的数值变量支持运行中采集。"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
}

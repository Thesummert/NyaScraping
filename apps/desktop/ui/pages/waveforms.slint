import { Button, ComboBox, LineEdit, ListView, Switch } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct WaveformRow {
    watch-index: int,
    node-index: int,
    name: string,
    scope: string,
    value: string,
    minimum: string,
    maximum: string,
    statistics: string,
    tint: color,
    chart-index: int,
}

export component WaveformsPage inherits VerticalLayout {
    in property <[WaveformRow]> channels;
    in property <[string]> charts;
    in property <int> selected-chart;
    in property <image> plot;
    in property <bool> detached;
    in property <bool> active;
    in property <string> status;
    in property <string> statistics;
    in-out property <string> endpoint;
    in property <string> source-label;
    in property <bool> use-session;
    in property <bool> session-ready;
    callback toggle-detached(bool);
    callback add-chart();
    callback select-chart(int);
    callback move-channel(int, int, int);
    callback start();
    callback stop();
    callback remove(int, int);
    spacing: 12px;
    HorizontalLayout {
        Text { text: "实时波形"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-stretch: 1; }
        Switch { text: "独立窗口"; checked: root.detached; toggled => { root.toggle-detached(self.checked); } }
        Text { text: root.channels.length + " / 16 通道"; color: Theme.accent; vertical-alignment: center; }
    }
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.source-label; color: Theme.muted; vertical-alignment: center; }
        if !root.use-session: LineEdit { text <=> root.endpoint; placeholder-text: "127.0.0.1:6666"; enabled: !root.active; horizontal-stretch: 1; }
        if root.use-session: Text { text: root.session-ready ? "复用当前连接" : "请先连接调试后端"; color: Theme.muted; horizontal-stretch: 1; vertical-alignment: center; }
        Button { text: "开始采集"; enabled: !root.active && root.channels.length > 0 && (!root.use-session || root.session-ready); clicked => { root.start(); } }
        Button { text: "停止"; enabled: root.active; clicked => { root.stop(); } }
    }
    Text { text: root.status; color: Theme.accent; overflow: elide; }
    Text { text: root.statistics; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        Text { text: "图表"; color: Theme.text; vertical-alignment: center; }
        chart-selector := ComboBox { model: root.charts; current-index: root.selected-chart; selected => { root.select-chart(chart-selector.current-index); } }
        Button { text: "新建图表"; clicked => { root.add-chart(); } }
    }
    Image { source: root.plot; min-height: 150px; vertical-stretch: 1; image-fit: fill; }
    Rectangle {
        height: 140px;
        background: Theme.background;
        ListView {
            for channel in root.channels: Rectangle {
                height: 100px;
                background: Theme.panel;
                border-radius: 16px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "● " + channel.name; color: channel.tint; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                        Text { text: channel.value; color: Theme.text; font-family: "monospace"; }
                        channel-chart := ComboBox { model: root.charts; current-index: channel.chart-index; selected => { root.move-channel(channel.watch-index, channel.node-index, channel-chart.current-index); } }
                        Button { text: "移除"; clicked => { root.remove(channel.watch-index, channel.node-index); } }
                    }
                    Text { text: channel.scope; color: Theme.muted; font-size: 10px; overflow: elide; }
                    HorizontalLayout {
                        Text { text: "Y " + channel.minimum + " … " + channel.maximum; color: Theme.muted; font-size: 10px; horizontal-stretch: 1; }
                        Text { text: channel.statistics; color: Theme.muted; font-size: 10px; }
                    }
                }
            }
        }
        if root.channels.length == 0: Text {
            text: "右键左侧变量 → 加入实时波形\n或打开右侧监视变量的「波形」开关";
            color: Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text { text: "运行中读内存 · 不暂停 CPU · 无目标端采样代码\n5 秒滚动时窗 / 各通道自动纵轴；采集全速运行，显示约 30 帧/秒。实际速度与总线影响取决于芯片和探针。"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
}

import { Button, ComboBox, LineEdit, ListView, Switch } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct WaveformRow {
    watch-index: int,
    node-index: int,
    name: string,
    scope: string,
    value: string,
    minimum: string,
    maximum: string,
    statistics: string,
    tint: color,
    chart-index: int,
}

export struct WaveformPath {
    commands: string,
    tint: color,
}

export component WaveformPlot inherits Rectangle {
    in property <[WaveformPath]> paths;
    background: #11161e;
    clip: true;
    for index in 4: Rectangle {
        x: parent.width * index / 4;
        width: 1px;
        height: parent.height;
        background: #2b3440;
    }
    for index in 4: Rectangle {
        y: parent.height * index / 4;
        height: 1px;
        width: parent.width;
        background: #2b3440;
    }
    for trace in root.paths: Path {
        width: parent.width;
        height: parent.height;
        // 800 x 400 with 1/16-pixel coordinates prepared by waveform_view.rs.
        viewbox-width: 12800;
        viewbox-height: 6400;
        fit: fill;
        clip: true;
        commands: trace.commands;
        stroke: trace.tint;
        stroke-width: 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

export component WaveformsPage inherits VerticalLayout {
    in property <bool> custom-background;
    in property <[WaveformRow]> channels;
    in property <[string]> charts;
    in property <int> selected-chart;
    in property <[WaveformPath]> paths;
    in property <[string]> axis-channels;
    in property <int> axis-index;
    in property <[string]> y-ticks;
    in property <[string]> time-ticks;
    in property <string> zoom-label;
    in-out property <bool> detached;
    in property <bool> active;
    in property <string> status;
    in property <string> statistics;
    in-out property <string> endpoint;
    in property <string> source-label;
    in property <bool> use-session;
    in property <bool> session-ready;
    callback toggle-detached(bool);
    callback zoom(bool, bool, bool);
    callback select-axis(int);
    callback add-chart();
    callback select-chart(int);
    callback move-channel(int, int, int);
    callback export-csv();
    callback clear-history();
    callback start();
    callback stop();
    callback remove(int, int);
    spacing: 8px;
    HorizontalLayout {
        Text { text: "实时波形"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-stretch: 1; }
        Switch { text: "独立窗口"; checked <=> root.detached; toggled => { root.toggle-detached(self.checked); } }
        Text { text: root.channels.length + " / 16 通道"; color: Theme.accent; vertical-alignment: center; }
    }
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.source-label; color: Theme.muted; vertical-alignment: center; }
        if !root.use-session: LineEdit { text <=> root.endpoint; placeholder-text: "127.0.0.1:6666"; enabled: !root.active; horizontal-stretch: 1; }
        if root.use-session: Text { text: root.session-ready ? "复用当前连接" : "请先连接调试后端"; color: Theme.muted; horizontal-stretch: 1; vertical-alignment: center; }
        Button { text: "开始采集"; enabled: !root.active && root.channels.length > 0 && (!root.use-session || root.session-ready); clicked => { root.start(); } }
        Button { text: "停止"; enabled: root.active; clicked => { root.stop(); } }
    }
    Text { text: root.status; color: Theme.accent; overflow: elide; }
    Text { text: root.statistics; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        Text { text: "图表"; color: Theme.text; vertical-alignment: center; }
        chart-selector := ComboBox { model: root.charts; current-index: root.selected-chart; selected => { root.select-chart(chart-selector.current-index); } }
        Button { text: "新建图表"; clicked => { root.add-chart(); } }
        Text { text: "纵轴通道"; color: Theme.muted; vertical-alignment: center; }
        axis-selector := ComboBox { model: root.axis-channels; current-index: root.axis-index; enabled: root.axis-channels.length > 0; selected => { root.select-axis(axis-selector.current-index); } }
        Text { text: root.zoom-label; color: Theme.muted; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; }
    }
    HorizontalLayout {
        min-height: 150px; vertical-stretch: 1; spacing: 4px;
        Rectangle {
            width: 78px;
            for tick[index] in root.y-ticks: Text {
                x: 0; width: parent.width; height: 16px;
                y: max(0px, min(parent.height - self.height, parent.height * index / 4 - self.height / 2));
                text: tick; color: Theme.muted; font-size: 10px; horizontal-alignment: right;
            }
        }
        WaveformPlot {
            horizontal-stretch: 1;
            paths: root.paths;
            menu := ContextMenuArea {
                Menu {
                    MenuItem { title: "导出当前图表为 CSV…"; activated => { root.export-csv(); } }
                    MenuItem { title: "清空当前图表历史波形"; activated => { root.clear-history(); } }
                }
            }
            TouchArea {
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        menu.show({ x: self.mouse-x, y: self.mouse-y });
                    }
                }
                scroll-event(event) => {
                    if event.delta-y != 0px { root.zoom(event.delta-y > 0px, event.modifiers.control, event.modifiers.alt); return accept; }
                    reject
                }
            }
        }
    }
    HorizontalLayout {
        Rectangle { width: 82px; }
        Rectangle {
            height: 18px; horizontal-stretch: 1;
            for tick[index] in root.time-ticks: Text {
                width: 80px; height: parent.height;
                x: max(0px, min(parent.width - self.width, parent.width * index / 4 - self.width / 2));
                text: tick; color: Theme.muted; font-size: 10px; horizontal-alignment: center;
            }
        }
    }
    Rectangle {
        height: 108px;
        background: root.custom-background ? #10121b55 : Theme.background;
        ListView {
            for channel in root.channels: Rectangle {
                height: 92px;
                background: Theme.panel;
                border-radius: 16px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "● " + channel.name; color: channel.tint; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                        Text { text: channel.value; color: Theme.text; font-family: "monospace"; }
                        channel-chart := ComboBox { model: root.charts; current-index: channel.chart-index; selected => { root.move-channel(channel.watch-index, channel.node-index, channel-chart.current-index); } }
                        Button { text: "移除"; clicked => { root.remove(channel.watch-index, channel.node-index); } }
                    }
                    Text { text: channel.scope; color: Theme.muted; font-size: 10px; overflow: elide; }
                    HorizontalLayout {
                        Text { text: "Y " + channel.minimum + " … " + channel.maximum; color: Theme.muted; font-size: 10px; horizontal-stretch: 1; }
                        Text { text: channel.statistics; color: Theme.muted; font-size: 10px; }
                    }
                }
            }
        }
        if root.channels.length == 0: Text {
            text: "右键左侧变量 → 加入实时波形\n或点击右侧监视变量的眼睛图标";
            color: Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text { text: "运行中读内存 · 不暂停 CPU · 无目标端采样代码\n时间轴相对最新采样时刻；各通道独立纵轴。滚轮缩放双轴，Ctrl + 滚轮缩放时间轴，Alt + 滚轮缩放纵轴。"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
}

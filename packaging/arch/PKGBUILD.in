# Generated by scripts/package-arch.sh from the current working tree.
pkgname=nya-scraping
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc='Embedded debug studio with source browsing, breakpoints and live waveforms'
arch=('x86_64')
url='https://github.com/Thesummert/NyaScraping'
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'fontconfig' 'freetype2' 'libxkbcommon'
         'libxkbcommon-x11' 'libxcb' 'libx11' 'wayland' 'libglvnd')
makedepends=('rust' 'clang' 'cmake' 'ninja' 'python' 'pkgconf')
optdepends=('gdb: debug sessions'
            'openocd: OpenOCD debugging backend'
            'probe-rs: probe-rs debugging backend'
            'tree-sitter-cli: source highlighting (grammars must be configured separately)'
            'xdg-desktop-portal: native file dialogs')
# Cargo controls LTO; do not create a separate debug package by default.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz" 'nya-scraping.desktop')
sha256sums=('@SOURCE_SHA256@' '@DESKTOP_SHA256@')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --frozen --release -p nya-scraping --target x86_64-unknown-linux-gnu
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    local target_dir="${CARGO_TARGET_DIR:-$PWD/target}"
    install -Dm755 "$target_dir/x86_64-unknown-linux-gnu/release/nya-scraping" \
        "$pkgdir/usr/bin/nya-scraping"
    install -Dm644 "$srcdir/nya-scraping.desktop" \
        "$pkgdir/usr/share/applications/nya-scraping.desktop"
    install -Dm644 apps/desktop/assets/icon.png \
        "$pkgdir/usr/share/pixmaps/nya-scraping.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
